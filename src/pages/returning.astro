---
import Base from '../layouts/Base.astro';
import Icon from '../components/Icon.astro';
import { detectCountry } from '../lib/geo';
import { getCurrencyPricing } from '../lib/pricing';
import { formatMoney } from '../lib/money';

export const prerender = false;

const isAuthed = !!Astro.locals.user;
const userEmail = Astro.locals.user?.email ?? '';
const authRedirect = `/register?next=/${encodeURIComponent('#followup-form')}`;
const country = detectCountry(Astro.request, Astro.locals.runtime);
const { currency, pricing } = await getCurrencyPricing(Astro.locals.runtime?.env?.SIDDH_KV, country);
const followupNow = formatMoney(pricing.followupCents, currency);
const followupWas = formatMoney(pricing.followupWasCents, currency);
---

<Base title="Follow Up on Your Janma Kundli | Siddh Jyotish" description="Return with your encrypted reference number for a follow-up reading on the Janma Kundli you already have — one price, answered from your existing chart." >
  <div class="wrap">
    <section class="block returning-section">
      <div class="section-head">
        <span class="eyebrow">Returning seeker</span>
        <h2>Follow up on your chart</h2>
        <p>
          Already have your Kundli? Paste your reference number and ask what
          you'd like to know, in one place. Your assigned pandit reuses your
          existing chart — no new PDF, just precise answers. One price for a
          follow-up on a chart you already have: <strong>{followupNow}</strong>.
        </p>
      </div>

      <div class="card card-accent narrow">
        {!isAuthed && (
          <div class="account-required" role="note" aria-live="polite">
            <span class="eyebrow">A private account is required</span>
            <p>Create a free account or sign in before asking a follow-up. Your account keeps your reports and future follow-ups together.</p>
            <div class="account-actions">
              <a class="btn" href={authRedirect}>Create account</a>
              <a class="btn btn-outline" href={`/login?next=/${encodeURIComponent('#followup-form')}`}>Log in</a>
            </div>
          </div>
        )}
        <form id="followup-form" data-authed={isAuthed ? 'true' : 'false'} data-auth-redirect={authRedirect} novalidate>
          <div class="field">
            <label for="reference">Reference number</label>
            <textarea id="reference" name="reference" placeholder="Paste your encrypted reference number" required></textarea>
            <p class="field-error" id="reference-error" aria-live="polite"></p>
          </div>

          <div class="field">
            <label for="email">Email</label>
            <input type="email" id="email" name="email" value={userEmail} required autocomplete="email" />
            <p class="field-error" id="email-error" aria-live="polite"></p>
          </div>

          <div class="field">
            <label for="followup">What would you like to ask about your chart?</label>
            <textarea id="followup" name="followup" maxlength="140" placeholder="e.g. When will my health improve?" required></textarea>
            <p class="helper">Keep it brief — up to 18 words.</p>
            <p class="field-error" id="followup-error" aria-live="polite"></p>
          </div>

          <div class="price-tag" style="margin-top:1.25rem">
            <s class="was">{followupWas}</s> <b>{followupNow}</b>
            <span>· follow-up on your existing chart</span>
          </div>

          <button type="submit" id="submit-btn" class="btn btn-block">Pay {followupNow} &amp; Get Answers</button>
          <div id="error" class="error" hidden></div>
          <p class="helper center secure-helper" style="margin-top:1rem"><Icon name="lock" size={16} /> Secure Stripe checkout · Answers delivered by email</p>
        </form>
      </div>

      <p class="center" style="margin-top:1.5rem"><a href="/">← Back to a new Siddh Jyotish reading</a></p>
    </section>
  </div>
</Base>

<style>
  .returning-section {
    background: url('/astro-bg.png') center/cover no-repeat;
    border-radius: 24px;
    padding-top: clamp(2.4rem, 5vw, 3.3rem);
    padding-bottom: clamp(2.4rem, 5vw, 3.3rem);
  }
  .returning-section .section-head,
  .returning-section .card,
  .returning-section .center {
    position: relative;
    z-index: 1;
  }
  .field { margin-bottom: 1rem; }
  .field:last-child { margin-bottom: 0; }
  .field-error {
    min-height: 1.1rem;
    margin: 0.35rem 0 0;
    color: var(--error);
    font-size: 0.88rem;
    line-height: 1.35;
  }
  .field-error:empty { display: block; }
  .field input.is-invalid,
  .field textarea.is-invalid {
    border-color: var(--error);
    box-shadow: 0 0 0 3px rgba(161, 32, 32, 0.14);
  }
  .account-required {
    border: 1px solid rgba(201, 162, 39, 0.45);
    border-radius: 14px;
    background: rgba(255, 250, 235, 0.8);
    padding: 1rem 1.1rem;
    margin-bottom: 1.25rem;
  }
  .account-required p { margin: 0.35rem 0 0; }
  .account-actions { display: flex; gap: 0.75rem; flex-wrap: wrap; margin-top: 0.85rem; }
  .secure-helper { display: inline-flex; align-items: center; gap: 0.35rem; }
  .card .price-tag b { color: var(--maroon); }
  .card .price-tag span { color: var(--muted); }
  .card .price-tag .was { color: var(--muted); }
  .returning-section {
    position: relative;
    overflow: hidden;
    background:
      linear-gradient(180deg, rgba(27,20,64,0.96), rgba(42,31,92,0.88)),
      url('/astro-bg.png') center/cover no-repeat;
  }
  .returning-section::before { content: ''; position: absolute; inset: 0; background: radial-gradient(circle at 85% 0%, rgba(201,162,39,0.2), transparent 35%); }
  .returning-section .section-head h2,
  .returning-section .section-head p { color: #fff; }
  .returning-section .section-head .eyebrow { color: var(--gold-soft); }
</style>

<script>
  const MAX_WORDS = 18;

  const form = document.getElementById('followup-form') as HTMLFormElement;
  const isAuthed = form.dataset.authed === 'true';
  const authRedirect = form.dataset.authRedirect ?? '/register';
  const btn = document.getElementById('submit-btn') as HTMLButtonElement;
  const errorEl = document.getElementById('error') as HTMLDivElement;
  const referenceInput = document.getElementById('reference') as HTMLTextAreaElement;
  const emailInput = document.getElementById('email') as HTMLInputElement;
  const followupInput = document.getElementById('followup') as HTMLTextAreaElement;

  function showError(message: string) {
    errorEl.textContent = message;
    errorEl.hidden = false;
  }

  function clearServerError() {
    errorEl.textContent = '';
    errorEl.hidden = true;
  }

  function value(id: string): string {
    const el = document.getElementById(id) as (HTMLInputElement | HTMLTextAreaElement) | null;
    return (el?.value ?? '').trim();
  }

  function words(value: string): number {
    return value.trim().split(/\s+/).filter(Boolean).length;
  }

  function setFieldError(input: HTMLInputElement | HTMLTextAreaElement, errorId: string, message = '') {
    input.classList.toggle('is-invalid', Boolean(message));
    input.setAttribute('aria-invalid', message ? 'true' : 'false');
    const error = document.getElementById(errorId);
    if (error) error.textContent = message;
  }

  function validateReference(): boolean {
    if (!value('reference')) {
      setFieldError(referenceInput, 'reference-error', 'Please enter your reference number.');
      return false;
    }
    setFieldError(referenceInput, 'reference-error');
    return true;
  }

  function validateEmail(): boolean {
    if (!value('email')) {
      setFieldError(emailInput, 'email-error', 'Please enter your email address.');
      return false;
    }
    if (!emailInput.checkValidity()) {
      setFieldError(emailInput, 'email-error', 'Enter a valid email address.');
      return false;
    }
    setFieldError(emailInput, 'email-error');
    return true;
  }

  function validateFollowup(showRequired = false): boolean {
    const text = value('followup');
    if (!text) {
      setFieldError(followupInput, 'followup-error', showRequired ? 'Please tell us what you would like to ask.' : '');
      return !showRequired;
    }
    if (words(text) > MAX_WORDS) {
      setFieldError(followupInput, 'followup-error', `Please keep it to ${MAX_WORDS} words or fewer.`);
      return false;
    }
    setFieldError(followupInput, 'followup-error');
    return true;
  }

  referenceInput.addEventListener('input', () => {
    if (referenceInput.classList.contains('is-invalid')) validateReference();
    clearServerError();
  });
  referenceInput.addEventListener('blur', validateReference);
  emailInput.addEventListener('input', () => {
    if (emailInput.classList.contains('is-invalid')) validateEmail();
    clearServerError();
  });
  emailInput.addEventListener('blur', validateEmail);
  followupInput.addEventListener('input', () => {
    validateFollowup();
    clearServerError();
  });
  followupInput.addEventListener('blur', () => validateFollowup(true));

  function validateAll(): boolean {
    clearServerError();
    const referenceOk = validateReference();
    const emailOk = validateEmail();
    const followupOk = validateFollowup(true);
    const isValid = referenceOk && emailOk && followupOk;
    if (!isValid) {
      [referenceInput, emailInput, followupInput].find((field) => field.classList.contains('is-invalid'))?.focus();
    }
    return isValid;
  }

  form.addEventListener('submit', async (event) => {
    event.preventDefault();
    errorEl.hidden = true;

    if (!isAuthed) {
      window.location.href = authRedirect;
      return;
    }

    if (!validateAll()) return;

    const payload = {
      reference: value('reference'),
      email: value('email'),
      questions: [value('followup')],
    };

    btn.disabled = true;
    const originalText = btn.textContent;
    btn.textContent = 'Redirecting to secure checkout…';

    try {
      const res = await fetch('/api/checkout/followup', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify(payload),
      });

      const data = await res.json().catch(() => ({}));

      if (res.status === 401 && data?.error === 'account_required') {
        window.location.href = authRedirect;
        return;
      }

      if (res.status === 200 && data && typeof data.url === 'string') {
        window.location.href = data.url;
        return;
      }

      showError((data && data.error) || 'Something went wrong. Please check your details and try again.');
    } catch {
      showError('Network error. Please try again.');
    } finally {
      btn.disabled = false;
      btn.textContent = originalText;
    }
  });
</script>
