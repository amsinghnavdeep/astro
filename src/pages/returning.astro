---
import Base from '../layouts/Base.astro';
import { detectCountry } from '../lib/geo';
import { getCurrencyPricing } from '../lib/pricing';
import { formatMoney } from '../lib/money';

export const prerender = false;

const isAuthed = !!Astro.locals.user;
const userEmail = Astro.locals.user?.email ?? '';
const authRedirect = `/register?next=/${encodeURIComponent('#followup-form')}`;
const country = detectCountry(Astro.request, Astro.locals.runtime);
const { currency, pricing } = await getCurrencyPricing(Astro.locals.runtime?.env?.SIDDH_KV, country);
const tiers = {
  1: {
    now: formatMoney(pricing.followupTierCents[1], currency),
    was: formatMoney(pricing.followupTierWasCents[1], currency),
  },
  2: {
    now: formatMoney(pricing.followupTierCents[2], currency),
    was: formatMoney(pricing.followupTierWasCents[2], currency),
  },
  3: {
    now: formatMoney(pricing.followupTierCents[3], currency),
    was: formatMoney(pricing.followupTierWasCents[3], currency),
  },
};
---

<Base title="Ask Follow-Up Astrology Questions | Siddh Jyotish" description="Return with your encrypted reference number to ask up to three follow-up astrology questions from the same Janma Kundli." >
  <div class="wrap">
    <section class="block returning-section">
      <div class="section-head">
        <span class="eyebrow">Returning seeker</span>
        <h2>Ask follow-up questions</h2>
        <p>
          Already have your Kundli? Paste your reference number and ask up to
          three precise questions. Your assigned pandit reuses your existing
          chart — no new PDF, just precise answers. Pricing:
          <strong>1 → {tiers[1].now} · 2 → {tiers[2].now} · 3 → {tiers[3].now}</strong> (max 18 words each).
        </p>
      </div>

      <div class="card card-accent narrow">
        {!isAuthed && (
          <div class="account-required" role="note" aria-live="polite">
            <span class="eyebrow">A private account is required</span>
            <p>Create a free account or sign in before asking follow-up questions. Your account keeps your reports and future questions together.</p>
            <div class="account-actions">
              <a class="btn" href={authRedirect}>Create account</a>
              <a class="btn btn-outline" href={`/login?next=/${encodeURIComponent('#followup-form')}`}>Log in</a>
            </div>
          </div>
        )}
        <form id="followup-form" novalidate>
          <div class="field">
            <label for="reference">Reference number</label>
            <textarea id="reference" name="reference" placeholder="Paste your encrypted reference number" required></textarea>
            <p class="field-error" id="reference-error" aria-live="polite"></p>
          </div>

          <div class="field">
            <label for="email">Email</label>
            <input type="email" id="email" name="email" value={userEmail} required autocomplete="email" />
            <p class="field-error" id="email-error" aria-live="polite"></p>
          </div>

          <div class="field">
            <label>Your questions (max 18 words each)</label>
            <div id="questions">
              <div class="question-field">
                <input type="text" class="question" placeholder="e.g. When will my health improve?" required />
                <p class="field-error question-error" aria-live="polite"></p>
              </div>
            </div>
          </div>
          <button type="button" id="add-question" class="btn btn-outline" style="margin-top:0.5rem">+ Add another question</button>

          <div class="price-tag" style="margin-top:1.25rem">
            <s class="was" id="was-price">{tiers[1].was}</s> <b id="now-price">{tiers[1].now}</b>
            <span id="price-note">· 1 question</span>
          </div>

          <button type="submit" id="submit-btn" class="btn btn-block">Pay <span id="btn-price">{tiers[1].now}</span> &amp; Get Answers</button>
          <div id="error" class="error" hidden></div>
          <p class="helper center" style="margin-top:1rem">🔒 Secure Stripe checkout · Answers delivered by email</p>
        </form>
      </div>

      <p class="center" style="margin-top:1.5rem"><a href="/">← Back to a new Siddh Jyotish reading</a></p>
    </section>
  </div>

  <script id="pricing-data" type="application/json" set:html={JSON.stringify(tiers)}></script>
</Base>

<style>
  .returning-section {
    background: url('/astro-bg.png') center/cover no-repeat;
    border-radius: 24px;
    padding-top: clamp(2.4rem, 5vw, 3.3rem);
    padding-bottom: clamp(2.4rem, 5vw, 3.3rem);
  }
  .returning-section .section-head,
  .returning-section .card,
  .returning-section .center {
    position: relative;
    z-index: 1;
  }
  .field { margin-bottom: 1rem; }
  .field:last-child { margin-bottom: 0; }
  .field-error {
    min-height: 1.1rem;
    margin: 0.35rem 0 0;
    color: var(--error);
    font-size: 0.88rem;
    line-height: 1.35;
  }
  .field-error:empty { display: block; }
  .field input.is-invalid,
  .field textarea.is-invalid {
    border-color: var(--error);
    box-shadow: 0 0 0 3px rgba(161, 32, 32, 0.14);
  }
  .question-field + .question-field {
    margin-top: 0.5rem;
  }
  .account-required {
    border: 1px solid rgba(201, 162, 39, 0.45);
    border-radius: 14px;
    background: rgba(255, 250, 235, 0.8);
    padding: 1rem 1.1rem;
    margin-bottom: 1.25rem;
  }
  .account-required p { margin: 0.35rem 0 0; }
  .account-actions { display: flex; gap: 0.75rem; flex-wrap: wrap; margin-top: 0.85rem; }
</style>

<script define:vars={{ isAuthed, authRedirect }}>
  const TIERS: Record<number, { now: string; was: string }> = (() => {
    const el = document.getElementById('pricing-data');
    try {
      return JSON.parse(el?.textContent || '{}');
    } catch {
      return {};
    }
  })();
  const MAX_QUESTIONS = 3;

  type QuestionField = {
    wrapper: HTMLDivElement;
    input: HTMLInputElement;
    error: HTMLElement;
  };

  const form = document.getElementById('followup-form') as HTMLFormElement;
  const btn = document.getElementById('submit-btn') as HTMLButtonElement;
  const errorEl = document.getElementById('error') as HTMLDivElement;
  const questionsEl = document.getElementById('questions') as HTMLDivElement;
  const addBtn = document.getElementById('add-question') as HTMLButtonElement;
  const wasPrice = document.getElementById('was-price') as HTMLElement;
  const nowPrice = document.getElementById('now-price') as HTMLElement;
  const priceNote = document.getElementById('price-note') as HTMLElement;
  const btnPrice = document.getElementById('btn-price') as HTMLElement;
  const referenceInput = document.getElementById('reference') as HTMLTextAreaElement;
  const emailInput = document.getElementById('email') as HTMLInputElement;

  function showError(message: string) {
    errorEl.textContent = message;
    errorEl.hidden = false;
  }

  function clearServerError() {
    errorEl.textContent = '';
    errorEl.hidden = true;
  }

  function value(id: string): string {
    const el = document.getElementById(id) as (HTMLInputElement | HTMLTextAreaElement) | null;
    return (el?.value ?? '').trim();
  }

  function words(value: string): number {
    return value.trim().split(/\s+/).filter(Boolean).length;
  }

  function getQuestionFields(): QuestionField[] {
    return Array.from(questionsEl.querySelectorAll<HTMLDivElement>('.question-field')).map((wrapper) => {
      const input = wrapper.querySelector<HTMLInputElement>('input.question');
      const error = wrapper.querySelector<HTMLElement>('.field-error');
      if (!input || !error) {
        throw new Error('Question field markup is incomplete');
      }
      return { wrapper, input, error };
    });
  }

  function setQuestionError(field: QuestionField, message = '') {
    field.error.textContent = message;
    field.input.classList.toggle('is-invalid', Boolean(message));
    field.input.setAttribute('aria-invalid', message ? 'true' : 'false');
  }

  function validateQuestionField(field: QuestionField): boolean {
    const value = field.input.value.trim();
    if (!value) {
      setQuestionError(field, '');
      return true;
    }
    if (words(value) > 18) {
      setQuestionError(field, 'Each question must be 18 words or fewer.');
      return false;
    }
    setQuestionError(field, '');
    return true;
  }

  function validateQuestions(showRequired = false): boolean {
    const fields = getQuestionFields();
    const values = fields.map((field) => field.input.value.trim());
    const anyFilled = values.some((value) => value.length > 0);

    if (!anyFilled) {
      fields.forEach((field) => setQuestionError(field, ''));
      if (showRequired && fields[0]) {
        setQuestionError(fields[0], 'Please enter at least one question.');
        return false;
      }
      return true;
    }

    let valid = true;
    fields.forEach((field) => {
      if (!validateQuestionField(field)) valid = false;
    });
    return valid;
  }

  function setReferenceError(message = '') {
    referenceInput.classList.toggle('is-invalid', Boolean(message));
    referenceInput.setAttribute('aria-invalid', message ? 'true' : 'false');
    const error = document.getElementById('reference-error');
    if (error) error.textContent = message;
  }

  function setEmailError(message = '') {
    emailInput.classList.toggle('is-invalid', Boolean(message));
    emailInput.setAttribute('aria-invalid', message ? 'true' : 'false');
    const error = document.getElementById('email-error');
    if (error) error.textContent = message;
  }

  function validateReference(): boolean {
    if (!value('reference')) {
      setReferenceError('Please enter your reference number.');
      return false;
    }
    setReferenceError('');
    return true;
  }

  function validateEmail(): boolean {
    if (!value('email')) {
      setEmailError('Please enter your email address.');
      return false;
    }
    if (!emailInput.checkValidity()) {
      setEmailError('Enter a valid email address.');
      return false;
    }
    setEmailError('');
    return true;
  }

  referenceInput.addEventListener('input', () => {
    if (referenceInput.classList.contains('is-invalid')) validateReference();
    clearServerError();
  });
  referenceInput.addEventListener('blur', validateReference);
  emailInput.addEventListener('input', () => {
    if (emailInput.classList.contains('is-invalid')) validateEmail();
    clearServerError();
  });
  emailInput.addEventListener('blur', validateEmail);

  function focusFirstInvalid(): void {
    const fields = [referenceInput, emailInput, ...getQuestionFields().map((field) => field.input)];
    fields.find((field) => field.classList.contains('is-invalid'))?.focus();
  }

  function refreshPrice() {
    const count = Math.min(Math.max(getQuestionFields().length, 1), MAX_QUESTIONS);
    const tier = TIERS[count];
    wasPrice.textContent = tier.was;
    nowPrice.textContent = tier.now;
    btnPrice.textContent = tier.now;
    priceNote.textContent = `· ${count} question${count === 1 ? '' : 's'}`;
    addBtn.style.display = count >= MAX_QUESTIONS ? 'none' : '';
  }

  function wireQuestionField(field: QuestionField) {
    field.input.addEventListener('input', () => {
      validateQuestionField(field);
      clearServerError();
    });
    field.input.addEventListener('blur', () => {
      const fields = getQuestionFields();
      const anyFilled = fields.some((item) => item.input.value.trim().length > 0);
      if (!anyFilled && field === fields[0]) {
        setQuestionError(field, 'Please enter at least one question.');
        return;
      }
      validateQuestionField(field);
    });
  }

  function createQuestionField(): QuestionField {
    const wrapper = document.createElement('div');
    wrapper.className = 'question-field';

    const input = document.createElement('input');
    input.type = 'text';
    input.className = 'question';
    input.placeholder = 'Another question (max 18 words)';
    input.required = true;

    const error = document.createElement('p');
    error.className = 'field-error question-error';
    error.setAttribute('aria-live', 'polite');

    wrapper.append(input, error);
    return { wrapper, input, error };
  }

  function addQuestion() {
    if (getQuestionFields().length >= MAX_QUESTIONS) return;
    const field = createQuestionField();
    questionsEl.appendChild(field.wrapper);
    wireQuestionField(field);
    clearServerError();
    refreshPrice();
  }

  function validateAll(): boolean {
    clearServerError();
    const referenceOk = validateReference();
    const emailOk = validateEmail();
    const questionsOk = validateQuestions(true);
    const isValid = referenceOk && emailOk && questionsOk;
    if (!isValid) focusFirstInvalid();
    return isValid;
  }

  addBtn.addEventListener('click', addQuestion);
  getQuestionFields().forEach(wireQuestionField);
  refreshPrice();

  form.addEventListener('submit', async (event) => {
    event.preventDefault();
    errorEl.hidden = true;

    if (!isAuthed) {
      window.location.href = authRedirect;
      return;
    }

    if (!validateAll()) return;

    const payload = {
      reference: value('reference'),
      email: value('email'),
      questions: getQuestionFields().map((field) => field.input.value.trim()).filter((q) => q.length > 0),
    };

    btn.disabled = true;
    const originalText = btn.textContent;
    btn.textContent = 'Redirecting to secure checkout…';

    try {
      const res = await fetch('/api/checkout/followup', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify(payload),
      });

      const data = await res.json().catch(() => ({}));

      if (res.status === 401 && data?.error === 'account_required') {
        window.location.href = authRedirect;
        return;
      }

      if (res.status === 200 && data && typeof data.url === 'string') {
        window.location.href = data.url;
        return;
      }

      showError((data && data.error) || 'Something went wrong. Please check your details and try again.');
    } catch {
      showError('Network error. Please try again.');
    } finally {
      btn.disabled = false;
      btn.textContent = originalText;
    }
  });
</script>