---
import Base from '../layouts/Base.astro';
import Icon from '../components/Icon.astro';
import { detectCountry } from '../lib/geo';
import { getCurrencyPricing } from '../lib/pricing';
import { formatMoney } from '../lib/money';

export const prerender = false;

const isAuthed = !!Astro.locals.user;
const userEmail = Astro.locals.user?.email ?? '';
const authRedirect = '/register?next=/order';
const country = detectCountry(Astro.request, Astro.locals.runtime);
const { currency, pricing } = await getCurrencyPricing(Astro.locals.runtime?.env?.SIDDH_KV, country);
const kundliNow = formatMoney(pricing.kundliCents, currency);
---

<Base
  title="Order your Janma Kundli | Siddh Jyotish"
  description="Order a precise Vedic Janma Kundli report prepared by a respected Vedic astrologer."
>
  <div class="wrap">
    <section class="block order-section" id="order">
      <div class="section-head">
        <h2>Order your Siddh Jyotish Janma Kundli</h2>
        <p>Secure checkout via Stripe. Your report is emailed to you once ready.</p>
      </div>
      <div class="card card-accent narrow">
        {!isAuthed && (
          <div class="account-required" role="note" aria-live="polite">
            <span class="eyebrow">A private account is required</span>
            <p>Create a free account or sign in before placing your order. Your account keeps your reports together and lets you return to this form.</p>
            <div class="account-actions">
              <a class="btn" href={authRedirect}>Create account</a>
              <a class="btn btn-outline" href={`/login?next=${encodeURIComponent('/order')}`}>Log in</a>
            </div>
          </div>
        )}
        <form id="kundli-form" data-authed={isAuthed ? 'true' : 'false'} data-auth-redirect={authRedirect} novalidate>
          <div class="field">
            <label for="fullName">Full name</label>
            <input type="text" id="fullName" name="fullName" required autocomplete="name" />
            <p class="field-error" id="fullName-error" aria-live="polite"></p>
          </div>

          <div class="grid-2">
            <div class="field">
              <label for="gender">Gender</label>
              <select id="gender" name="gender" required>
                <option value="" disabled selected>Select…</option>
                <option value="Male">Male</option>
                <option value="Female">Female</option>
                <option value="Other">Other</option>
              </select>
              <p class="field-error" id="gender-error" aria-live="polite"></p>
            </div>
            <div class="field">
              <label for="dateOfBirth">Date of birth</label>
              <input type="date" id="dateOfBirth" name="dateOfBirth" min="1900-01-01" required />
              <p class="field-error" id="dateOfBirth-error" aria-live="polite"></p>
            </div>
          </div>

          <div class="field">
            <label for="timeOfBirth">Time of birth</label>
            <input type="time" id="timeOfBirth" name="timeOfBirth" required />
            <p class="field-error" id="timeOfBirth-error" aria-live="polite"></p>
          </div>

          <div class="field place-field">
            <label for="placeOfBirth">Place of birth</label>
            <div class="autocomplete-shell">
              <input type="text" id="placeOfBirth" name="placeOfBirth" placeholder="City, State, Country" required autocomplete="off" aria-autocomplete="list" aria-expanded="false" aria-controls="placeOfBirth-suggestions" />
              <div id="placeOfBirth-suggestions" class="autocomplete-list" role="listbox" aria-label="Place suggestions" hidden></div>
            </div>
            <p class="field-error" id="placeOfBirth-error" aria-live="polite"></p>
          </div>

          <div class="field">
            <label for="timezone">Timezone of birthplace</label>
            <select id="timezone" name="timezone" required>
              <option value="" disabled selected>Select the timezone of your birthplace…</option>
              <optgroup label="India &amp; South Asia">
                <option value="Asia/Kolkata">India — Asia/Kolkata (IST, UTC+5:30)</option>
                <option value="Asia/Karachi">Pakistan — Asia/Karachi (UTC+5)</option>
                <option value="Asia/Dhaka">Bangladesh — Asia/Dhaka (UTC+6)</option>
                <option value="Asia/Kathmandu">Nepal — Asia/Kathmandu (UTC+5:45)</option>
                <option value="Asia/Colombo">Sri Lanka — Asia/Colombo (UTC+5:30)</option>
                <option value="Asia/Thimphu">Bhutan — Asia/Thimphu (UTC+6)</option>
                <option value="Asia/Kabul">Afghanistan — Asia/Kabul (UTC+4:30)</option>
              </optgroup>
              <optgroup label="Middle East &amp; West Asia">
                <option value="Asia/Dubai">UAE — Asia/Dubai (UTC+4)</option>
                <option value="Asia/Riyadh">Saudi Arabia — Asia/Riyadh (UTC+3)</option>
                <option value="Asia/Qatar">Qatar — Asia/Qatar (UTC+3)</option>
                <option value="Asia/Kuwait">Kuwait — Asia/Kuwait (UTC+3)</option>
                <option value="Asia/Muscat">Oman — Asia/Muscat (UTC+4)</option>
                <option value="Asia/Tehran">Iran — Asia/Tehran (UTC+3:30)</option>
                <option value="Asia/Jerusalem">Israel — Asia/Jerusalem (UTC+2)</option>
              </optgroup>
              <optgroup label="East &amp; Southeast Asia">
                <option value="Asia/Shanghai">China — Asia/Shanghai (UTC+8)</option>
                <option value="Asia/Hong_Kong">Hong Kong — Asia/Hong_Kong (UTC+8)</option>
                <option value="Asia/Singapore">Singapore — Asia/Singapore (UTC+8)</option>
                <option value="Asia/Kuala_Lumpur">Malaysia — Asia/Kuala_Lumpur (UTC+8)</option>
                <option value="Asia/Jakarta">Indonesia (west) — Asia/Jakarta (UTC+7)</option>
                <option value="Asia/Bangkok">Thailand — Asia/Bangkok (UTC+7)</option>
                <option value="Asia/Ho_Chi_Minh">Vietnam — Asia/Ho_Chi_Minh (UTC+7)</option>
                <option value="Asia/Manila">Philippines — Asia/Manila (UTC+8)</option>
                <option value="Asia/Tokyo">Japan — Asia/Tokyo (UTC+9)</option>
                <option value="Asia/Seoul">South Korea — Asia/Seoul (UTC+9)</option>
              </optgroup>
              <optgroup label="Europe">
                <option value="Europe/London">UK / Ireland — Europe/London (UTC+0)</option>
                <option value="Europe/Paris">France — Europe/Paris (UTC+1)</option>
                <option value="Europe/Berlin">Germany — Europe/Berlin (UTC+1)</option>
                <option value="Europe/Madrid">Spain — Europe/Madrid (UTC+1)</option>
                <option value="Europe/Rome">Italy — Europe/Rome (UTC+1)</option>
                <option value="Europe/Amsterdam">Netherlands — Europe/Amsterdam (UTC+1)</option>
                <option value="Europe/Athens">Greece — Europe/Athens (UTC+2)</option>
                <option value="Europe/Istanbul">Turkey — Europe/Istanbul (UTC+3)</option>
                <option value="Europe/Moscow">Russia (Moscow) — Europe/Moscow (UTC+3)</option>
              </optgroup>
              <optgroup label="Africa">
                <option value="Africa/Lagos">Nigeria — Africa/Lagos (UTC+1)</option>
                <option value="Africa/Cairo">Egypt — Africa/Cairo (UTC+2)</option>
                <option value="Africa/Johannesburg">South Africa — Africa/Johannesburg (UTC+2)</option>
                <option value="Africa/Nairobi">Kenya — Africa/Nairobi (UTC+3)</option>
                <option value="Indian/Mauritius">Mauritius — Indian/Mauritius (UTC+4)</option>
              </optgroup>
              <optgroup label="North America">
                <option value="America/New_York">US Eastern — America/New_York (UTC−5)</option>
                <option value="America/Chicago">US Central — America/Chicago (UTC−6)</option>
                <option value="America/Denver">US Mountain — America/Denver (UTC−7)</option>
                <option value="America/Los_Angeles">US Pacific — America/Los_Angeles (UTC−8)</option>
                <option value="America/Toronto">Canada Eastern — America/Toronto (UTC−5)</option>
                <option value="America/Vancouver">Canada Pacific — America/Vancouver (UTC−8)</option>
                <option value="America/Mexico_City">Mexico — America/Mexico_City (UTC−6)</option>
              </optgroup>
              <optgroup label="Central &amp; South America">
                <option value="America/Sao_Paulo">Brazil (São Paulo) — America/Sao_Paulo (UTC−3)</option>
                <option value="America/Argentina/Buenos_Aires">Argentina — America/Argentina/Buenos_Aires (UTC−3)</option>
                <option value="America/Bogota">Colombia — America/Bogota (UTC−5)</option>
                <option value="America/Lima">Peru — America/Lima (UTC−5)</option>
                <option value="America/Santiago">Chile — America/Santiago (UTC−4)</option>
              </optgroup>
              <optgroup label="Oceania">
                <option value="Australia/Sydney">Australia Eastern — Australia/Sydney (UTC+10)</option>
                <option value="Australia/Perth">Australia Western — Australia/Perth (UTC+8)</option>
                <option value="Pacific/Auckland">New Zealand — Pacific/Auckland (UTC+12)</option>
                <option value="Pacific/Fiji">Fiji — Pacific/Fiji (UTC+12)</option>
              </optgroup>
              <optgroup label="Other">
                <option value="UTC">UTC (Coordinated Universal Time)</option>
              </optgroup>
            </select>
            <p class="helper" style="margin-top:0.35rem">The timezone of the town/city where you were born — not where you live now.</p>
            <p class="field-error" id="timezone-error" aria-live="polite"></p>
          </div>

          <div class="field">
            <label for="email">Email</label>
            <input type="email" id="email" name="email" value={userEmail} required autocomplete="email" />
            <p class="field-error" id="email-error" aria-live="polite"></p>
          </div>

          <div class="field">
            <label for="q1">3 questions included with your report (max 18 words each)</label>
            <input type="text" id="q1" name="q1" placeholder="When will I get married?" />
            <p class="field-error" id="q1-error" aria-live="polite"></p>
            <input type="text" id="q2" name="q2" placeholder="When will I get a good job / promotion?" style="margin-top:0.5rem" />
            <p class="field-error" id="q2-error" aria-live="polite"></p>
            <input type="text" id="q3" name="q3" placeholder="When will we be blessed with a child?" style="margin-top:0.5rem" />
            <p class="field-error" id="q3-error" aria-live="polite"></p>
          </div>

          <button type="submit" id="submit-btn" class="btn btn-block">Pay {kundliNow} &amp; Get Kundli Report and Answers</button>
          <div id="error" class="error" hidden></div>
          <p class="helper center secure-helper" style="margin-top:1rem"><Icon name="lock" size={16} /> Secure Stripe checkout · 100% money-back guarantee</p>
        </form>
      </div>
      <p class="center gifting-note">
        <strong>Gifting a reading?</strong> Enter your loved one's birth details
        and your own email — we'll send the report to you so you can present it
        yourself.
      </p>
    </section>
  </div>


</Base>

<style>
  .field { margin-bottom: 1rem; }
  .field:last-child { margin-bottom: 0; }
  .field-error {
    min-height: 1.1rem;
    margin: 0.35rem 0 0;
    color: var(--error);
    font-size: 0.88rem;
    line-height: 1.35;
  }
  .field-error:empty { display: block; }
  .field input.is-invalid,
  .field select.is-invalid,
  .field textarea.is-invalid {
    border-color: var(--error);
    box-shadow: 0 0 0 3px rgba(161, 32, 32, 0.14);
  }
  .place-field { position: relative; }
  .autocomplete-shell { position: relative; }
  .autocomplete-list {
    position: absolute;
    top: calc(100% + 0.4rem);
    left: 0;
    right: 0;
    z-index: 20;
    background: var(--card);
    border: 1px solid var(--border);
    border-radius: 14px;
    box-shadow: 0 18px 36px rgba(27,20,64,0.14);
    padding: 0.25rem;
    max-height: 280px;
    overflow: auto;
  }
  .autocomplete-option {
    width: 100%;
    border: 0;
    background: transparent;
    color: var(--text);
    font: inherit;
    text-align: left;
    padding: 0.8rem 0.9rem;
    border-radius: 10px;
    cursor: pointer;
  }
  .autocomplete-option:hover,
  .autocomplete-option.is-active {
    background: #f8edd0;
    color: var(--maroon-deep);
  }
  .autocomplete-option strong {
    color: var(--maroon);
    font-weight: 700;
  }
  .autocomplete-empty {
    padding: 0.8rem 0.9rem;
    color: var(--muted);
    font-size: 0.92rem;
  }
  .autocomplete-shell input {
    padding-right: 2.25rem;
  }

  /* Order section background */
  .order-section {
    background: url('/astro-bg.png') center/cover no-repeat;
    border-radius: 24px;
    padding-top: clamp(2.4rem, 5vw, 3.3rem);
    padding-bottom: clamp(2.4rem, 5vw, 3.3rem);
  }
  .order-section .section-head,
  .order-section .gifting-note {
    position: relative;
    z-index: 1;
  }
  .order-section .card {
    position: relative;
    z-index: 1;
    background: var(--card);
  }

  .gifting-note {
    color: var(--muted);
    font-size: 0.95rem;
    margin-top: 1.2rem;
  }


  .account-required {
    border: 1px solid rgba(201, 162, 39, 0.45);
    border-radius: 14px;
    background: rgba(255, 250, 235, 0.8);
    padding: 1rem 1.1rem;
    margin-bottom: 1.25rem;
  }
  .account-required p { margin: 0.35rem 0 0; }
  .account-actions { display: flex; gap: 0.75rem; flex-wrap: wrap; margin-top: 0.85rem; }
  .secure-helper { display: flex; align-items: center; gap: 0.4rem; }
</style>

<script>
  const MIN_BIRTH_DATE = '1900-01-01';
  const MONTHS = ['Jan', 'Feb', 'Mar', 'Apr', 'May', 'Jun', 'Jul', 'Aug', 'Sep', 'Oct', 'Nov', 'Dec'];

  type ValidationTarget = HTMLInputElement | HTMLSelectElement | HTMLTextAreaElement;
  type PhotonFeature = {
    properties?: Record<string, unknown>;
  };

  const form = document.getElementById('kundli-form') as HTMLFormElement;
  const isAuthed = form.dataset.authed === 'true';
  const authRedirect = form.dataset.authRedirect ?? '/register';
  const btn = document.getElementById('submit-btn') as HTMLButtonElement;
  const serverErrorEl = document.getElementById('error') as HTMLDivElement;
  const fullNameInput = document.getElementById('fullName') as HTMLInputElement;
  const genderSelect = document.getElementById('gender') as HTMLSelectElement;
  const dateInput = document.getElementById('dateOfBirth') as HTMLInputElement;
  const timeInput = document.getElementById('timeOfBirth') as HTMLInputElement;
  const placeInput = document.getElementById('placeOfBirth') as HTMLInputElement;
  const placeMenu = document.getElementById('placeOfBirth-suggestions') as HTMLDivElement;
  const timezoneSelect = document.getElementById('timezone') as HTMLSelectElement;
  const emailInput = document.getElementById('email') as HTMLInputElement;
  const questionInputs = ['q1', 'q2', 'q3']
    .map((id) => document.getElementById(id) as HTMLInputElement)
    .filter(Boolean);

  const placeShell = placeInput.closest('.autocomplete-shell') as HTMLElement | null;

  let debounceHandle: number | undefined;
  let requestToken = 0;
  let suggestions: string[] = [];
  let activeIndex = -1;

  function pad2(value: number): string {
    return String(value).padStart(2, '0');
  }

  function setTodayLimits() {
    const now = new Date();
    dateInput.max = `${now.getFullYear()}-${pad2(now.getMonth() + 1)}-${pad2(now.getDate())}`;
    dateInput.min = MIN_BIRTH_DATE;
  }

  function fieldErrorId(id: string): string {
    return `${id}-error`;
  }

  function getErrorEl(id: string): HTMLElement | null {
    return document.getElementById(fieldErrorId(id));
  }

  function setFieldError(field: ValidationTarget, id: string, message = '') {
    const errorEl = getErrorEl(id);
    if (errorEl) errorEl.textContent = message;
    field.classList.toggle('is-invalid', Boolean(message));
    field.setAttribute('aria-invalid', message ? 'true' : 'false');
  }

  function clearFieldError(field: ValidationTarget, id: string) {
    setFieldError(field, id, '');
  }

  function trimValue(field: ValidationTarget): string {
    return field.value.trim();
  }

  function words(value: string): number {
    return value.trim().split(/\s+/).filter(Boolean).length;
  }

  function formatBirthDate(value: string): string {
    const [year, month, day] = value.split('-').map(Number);
    if (!year || !month || !day) return '';
    return `${day} ${MONTHS[month - 1]} ${year}`;
  }

  function formatTime(value: string): string {
    const [hoursRaw, minutesRaw] = value.split(':');
    const hours = Number(hoursRaw);
    const minutes = Number(minutesRaw);
    if (!Number.isFinite(hours) || !Number.isFinite(minutes)) return '';
    const period = hours >= 12 ? 'PM' : 'AM';
    const normalizedHours = hours % 12 || 12;
    return `${normalizedHours}:${pad2(minutes)} ${period}`;
  }

  function validateRequiredField(field: ValidationTarget, id: string, message: string): boolean {
    if (!trimValue(field)) {
      setFieldError(field, id, message);
      return false;
    }
    if (!field.checkValidity()) {
      setFieldError(field, id, message);
      return false;
    }
    clearFieldError(field, id);
    return true;
  }

  function validateEmailField(): boolean {
    if (!trimValue(emailInput)) {
      setFieldError(emailInput, 'email', 'Please enter your email address.');
      return false;
    }
    if (!emailInput.checkValidity()) {
      setFieldError(emailInput, 'email', 'Enter a valid email address.');
      return false;
    }
    clearFieldError(emailInput, 'email');
    return true;
  }

  function validateDateField(): boolean {
    if (!trimValue(dateInput)) {
      setFieldError(dateInput, 'dateOfBirth', 'Please select your date of birth.');
      return false;
    }
    if (!dateInput.checkValidity()) {
      setFieldError(dateInput, 'dateOfBirth', 'Please select a valid date of birth.');
      return false;
    }
    clearFieldError(dateInput, 'dateOfBirth');
    return true;
  }

  function validateTimeField(): boolean {
    if (!trimValue(timeInput)) {
      setFieldError(timeInput, 'timeOfBirth', 'Please select your time of birth.');
      return false;
    }
    if (!timeInput.checkValidity()) {
      setFieldError(timeInput, 'timeOfBirth', 'Please select a valid time of birth.');
      return false;
    }
    clearFieldError(timeInput, 'timeOfBirth');
    return true;
  }

  function validatePlaceField(): boolean {
    if (!trimValue(placeInput)) {
      setFieldError(placeInput, 'placeOfBirth', 'Please enter your place of birth.');
      return false;
    }
    clearFieldError(placeInput, 'placeOfBirth');
    return true;
  }

  function validateTimezoneField(): boolean {
    if (!timezoneSelect.value) {
      setFieldError(timezoneSelect, 'timezone', 'Please select the timezone of your birthplace.');
      return false;
    }
    clearFieldError(timezoneSelect, 'timezone');
    return true;
  }

  function validateQuestionField(input: HTMLInputElement): boolean {
    const value = trimValue(input);
    if (!value) {
      clearFieldError(input, input.id);
      return true;
    }
    if (words(value) > 18) {
      setFieldError(input, input.id, 'Each question must be 18 words or fewer.');
      return false;
    }
    clearFieldError(input, input.id);
    return true;
  }

  function validateQuestions(): boolean {
    let valid = true;
    questionInputs.forEach((input) => {
      if (!validateQuestionField(input)) valid = false;
    });
    return valid;
  }

  function clearServerError() {
    serverErrorEl.hidden = true;
    serverErrorEl.textContent = '';
  }

  function showServerError(message: string) {
    serverErrorEl.textContent = message;
    serverErrorEl.hidden = false;
  }

  function collectQuestions(): string[] {
    return questionInputs.map((input) => input.value.trim()).filter((q) => q.length > 0);
  }

  function focusFirstInvalid(fields: ValidationTarget[]): void {
    const firstInvalid = fields.find((field) => field.classList.contains('is-invalid'));
    firstInvalid?.focus();
  }

  function validateAllFields(): boolean {
    clearServerError();

    const validFields = [
      validateRequiredField(fullNameInput, 'fullName', 'Please enter your full name.'),
      validateRequiredField(genderSelect, 'gender', 'Please select your gender.'),
      validateDateField(),
      validateTimeField(),
      validatePlaceField(),
      validateTimezoneField(),
      validateEmailField(),
      validateQuestions(),
    ];

    const isValid = validFields.every(Boolean);
    if (!isValid) {
      focusFirstInvalid([fullNameInput, genderSelect, dateInput, timeInput, placeInput, timezoneSelect, emailInput, ...questionInputs]);
    }
    return isValid;
  }

  function bindLiveValidation(field: ValidationTarget, handler: () => boolean, eventName: 'input' | 'change') {
    field.addEventListener('blur', handler);
    field.addEventListener(eventName, handler);
  }

  setTodayLimits();

  bindLiveValidation(fullNameInput, () => validateRequiredField(fullNameInput, 'fullName', 'Please enter your full name.'), 'input');
  bindLiveValidation(genderSelect, () => validateRequiredField(genderSelect, 'gender', 'Please select your gender.'), 'change');
  bindLiveValidation(dateInput, validateDateField, 'input');
  bindLiveValidation(timeInput, validateTimeField, 'input');
  bindLiveValidation(placeInput, validatePlaceField, 'input');
  bindLiveValidation(timezoneSelect, validateTimezoneField, 'change');
  bindLiveValidation(emailInput, validateEmailField, 'input');
  questionInputs.forEach((input) => {
    input.addEventListener('blur', () => validateQuestionField(input));
    input.addEventListener('input', () => validateQuestionField(input));
  });

  function renderPlaceSuggestions(items: string[]) {
    suggestions = items;
    activeIndex = items.length ? 0 : -1;
    placeMenu.innerHTML = '';

    if (!items.length) {
      placeMenu.hidden = true;
      placeInput.setAttribute('aria-expanded', 'false');
      placeInput.removeAttribute('aria-activedescendant');
      return;
    }

    items.forEach((label, index) => {
      const option = document.createElement('button');
      option.type = 'button';
      option.className = `autocomplete-option${index === activeIndex ? ' is-active' : ''}`;
      option.id = `place-option-${index}`;
      option.setAttribute('role', 'option');
      option.setAttribute('aria-selected', String(index === activeIndex));
      option.textContent = label;
      option.addEventListener('mousedown', (event) => {
        event.preventDefault();
        choosePlaceSuggestion(index);
      });
      placeMenu.appendChild(option);
    });

    placeMenu.hidden = false;
    placeInput.setAttribute('aria-expanded', 'true');
    updateActiveOption();
  }

  function updateActiveOption() {
    const options = Array.from(placeMenu.querySelectorAll<HTMLButtonElement>('.autocomplete-option'));
    options.forEach((option, index) => {
      const isActive = index === activeIndex;
      option.classList.toggle('is-active', isActive);
      option.setAttribute('aria-selected', String(isActive));
    });
    const activeOption = activeIndex >= 0 ? options[activeIndex] : null;
    if (activeOption) {
      placeInput.setAttribute('aria-activedescendant', activeOption.id);
      activeOption.scrollIntoView({ block: 'nearest' });
    } else {
      placeInput.removeAttribute('aria-activedescendant');
    }
  }

  function hidePlaceSuggestions() {
    placeMenu.hidden = true;
    placeMenu.innerHTML = '';
    suggestions = [];
    activeIndex = -1;
    placeInput.setAttribute('aria-expanded', 'false');
    placeInput.removeAttribute('aria-activedescendant');
  }

  function choosePlaceSuggestion(index: number) {
    const label = suggestions[index];
    if (!label) return;
    placeInput.value = label;
    clearFieldError(placeInput, 'placeOfBirth');
    hidePlaceSuggestions();
    placeInput.focus();
  }

  function composePlaceLabel(feature: PhotonFeature): string {
    const props = feature.properties ?? {};
    const pieces = [props.name, props.city, props.state, props.country]
      .filter((value): value is string => typeof value === 'string' && value.trim().length > 0)
      .map((value) => value.trim());
    const unique: string[] = [];
    pieces.forEach((piece) => {
      if (!unique.includes(piece)) unique.push(piece);
    });
    return unique.join(', ');
  }

  async function searchPlaces(query: string) {
    const currentToken = ++requestToken;
    try {
      const response = await fetch(`https://photon.komoot.io/api/?q=${encodeURIComponent(query)}&limit=5&lang=en`);
      if (!response.ok) throw new Error('Lookup failed');
      const data = (await response.json()) as { features?: PhotonFeature[] };
      if (currentToken !== requestToken) return;
      const labels = (data.features ?? [])
        .map((feature) => composePlaceLabel(feature))
        .filter((label) => label.length > 0)
        .slice(0, 5);
      renderPlaceSuggestions(labels);
    } catch {
      if (currentToken === requestToken) hidePlaceSuggestions();
    }
  }

  function schedulePlaceSearch() {
    window.clearTimeout(debounceHandle);
    const query = trimValue(placeInput);
    if (query.length < 3) {
      hidePlaceSuggestions();
      return;
    }
    debounceHandle = window.setTimeout(() => {
      void searchPlaces(query);
    }, 350);
  }

  placeInput.addEventListener('input', () => {
    validatePlaceField();
    schedulePlaceSearch();
  });
  placeInput.addEventListener('focus', () => {
    if (trimValue(placeInput).length >= 3) {
      if (suggestions.length) {
        renderPlaceSuggestions(suggestions);
      } else {
        schedulePlaceSearch();
      }
    }
  });
  placeInput.addEventListener('blur', () => {
    window.setTimeout(() => {
      hidePlaceSuggestions();
    }, 120);
    validatePlaceField();
  });
  placeInput.addEventListener('keydown', (event) => {
    if (placeMenu.hidden || !suggestions.length) return;
    if (event.key === 'ArrowDown') {
      event.preventDefault();
      activeIndex = (activeIndex + 1) % suggestions.length;
      updateActiveOption();
    } else if (event.key === 'ArrowUp') {
      event.preventDefault();
      activeIndex = (activeIndex - 1 + suggestions.length) % suggestions.length;
      updateActiveOption();
    } else if (event.key === 'Enter' && activeIndex >= 0) {
      event.preventDefault();
      choosePlaceSuggestion(activeIndex);
    } else if (event.key === 'Escape') {
      event.preventDefault();
      hidePlaceSuggestions();
    }
  });

  if (placeShell) {
    document.addEventListener('click', (event) => {
      if (!placeShell.contains(event.target as Node)) hidePlaceSuggestions();
    });
  }

  form.addEventListener('submit', async (event) => {
    event.preventDefault();
    hidePlaceSuggestions();

    if (!isAuthed) {
      window.location.href = authRedirect;
      return;
    }

    const isValid = validateAllFields();
    if (!isValid) return;

    const payload = {
      fullName: fullNameInput.value.trim(),
      gender: genderSelect.value,
      dateOfBirth: formatBirthDate(dateInput.value),
      timeOfBirth: formatTime(timeInput.value),
      placeOfBirth: placeInput.value.trim(),
      timezone: timezoneSelect.value,
      email: emailInput.value.trim(),
      questions: collectQuestions(),
    };

    btn.disabled = true;
    const originalText = btn.textContent;
    btn.textContent = 'Redirecting to secure checkout…';

    try {
      const res = await fetch('/api/checkout/new', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify(payload),
      });

      const data = await res.json().catch(() => ({}));

      if (res.status === 401 && data?.error === 'account_required') {
        window.location.href = authRedirect;
        return;
      }

      if (res.status === 200 && data && typeof data.url === 'string') {
        window.location.href = data.url;
        return;
      }

      showServerError((data && data.error) || 'Something went wrong. Please check your details and try again.');
    } catch {
      showServerError('Network error. Please try again.');
    } finally {
      btn.disabled = false;
      btn.textContent = originalText;
    }
  });
</script>
