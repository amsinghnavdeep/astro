---
import Base from '../layouts/Base.astro';
---

<Base title="Payment received | Siddh Jyotish" description="Your payment was received. Your Janma Kundli report is now being prepared and will be emailed shortly." noindex>
  <div class="wrap">
    <section class="block">
      <div class="card narrow success-hero">
        <div class="divider-om">🕉️</div>
        <h1>Payment received 🎉</h1>
        <p id="status" class="lead">Confirming your payment…</p>

        <div id="pandit-box" hidden>
          <div class="pandit-card">
            <div class="pandit-avatar" aria-hidden="true">🧑‍🦳</div>
            <div>
              <p style="margin:0"><strong id="pandit-name">Our senior astrologer</strong> is now personally studying your Janma Kundli.</p>
              <p class="helper" style="margin:0.3rem 0 0">You'll receive your complete report by email shortly — please keep an eye on your inbox.</p>
            </div>
          </div>
        </div>

        <p class="helper">You can safely close this page — everything arrives by email.</p>
        <p class="helper spam-note">📩 Not in your inbox? Please check your <strong>Spam</strong> or <strong>Promotions</strong> folder — and mark us as “Not spam” so future messages land in your inbox.</p>
        <p style="margin-top:1rem"><a href="/">← Back home</a></p>
      </div>
    </section>
  </div>
</Base>

<script>
  const statusEl = document.getElementById('status') as HTMLParagraphElement;
  const panditBox = document.getElementById('pandit-box') as HTMLDivElement;
  const panditName = document.getElementById('pandit-name') as HTMLElement;

  const params = new URLSearchParams(window.location.search);
  const sessionId = params.get('session_id');

  const POLL_MS = 4000;
  const MAX_MS = 5 * 60 * 1000;
  const startedAt = Date.now();

  async function poll() {
    if (!sessionId) {
      statusEl.textContent = 'Missing session id. If you just paid, please check your email.';
      return;
    }

    if (Date.now() - startedAt > MAX_MS) {
      statusEl.textContent =
        'Still processing. You can close this page — everything will arrive by email.';
      return;
    }

    try {
      const res = await fetch(`/api/status?session_id=${encodeURIComponent(sessionId)}`);
      const data = await res.json().catch(() => ({}));

      if (data && data.state === 'paid') {
        if (data.kind === 'followup') {
          statusEl.textContent =
            'Thank you! Your astrologer is preparing your answers and will email them to you shortly.';
        } else {
          const pandit = (data.pandit && String(data.pandit)) || 'Our senior astrologer';
          panditName.textContent = pandit;
          panditBox.hidden = false;
          statusEl.textContent = 'Thank you — your reading has begun. 🙏';
        }
        return;
      }

      statusEl.textContent = 'Confirming your payment…';
    } catch {
      statusEl.textContent = 'Confirming your payment…';
    }

    setTimeout(poll, POLL_MS);
  }

  poll();
</script>
