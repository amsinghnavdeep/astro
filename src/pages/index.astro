---
import Base from '../layouts/Base.astro';
import { detectCountry } from '../lib/geo';
import { getCurrencyPricing } from '../lib/pricing';
import { formatMoney } from '../lib/money';

export const prerender = false;

const country = detectCountry(Astro.request, Astro.locals.runtime);
const { currency, pricing } = await getCurrencyPricing(Astro.locals.runtime?.env?.SIDDH_KV, country);
const kundliNow = formatMoney(pricing.kundliCents, currency);
const kundliWas = formatMoney(pricing.kundliWasCents, currency);
const f1 = formatMoney(pricing.followupTierCents[1], currency);
const f2 = formatMoney(pricing.followupTierCents[2], currency);
const f3 = formatMoney(pricing.followupTierCents[3], currency);
---

<Base title="Siddh Jyotish — Your Vedic Birth Chart, Created with Precision">
  <div class="wrap wrap-wide">
    <section class="hero hero-split">
      <div class="hero-grid">
        <div class="hero-copy">
          <span class="eyebrow">Siddh Jyotish · Prepared by respected and siddh astrologers</span>
          <h1>Your Janma Kundli, created &amp; analysed by hand.</h1>
          <p class="lead" style="max-width:56ch">
            Not a generic horoscope. A genuine Vedic birth chart, cast from your exact birth details and interpreted by hand. <strong>Know your path with clarity and precision.</strong>
          </p>
          <div class="price-tag">
            <s class="was">{kundliWas}</s> <b>{kundliNow}</b><span>· complete Kundli + 3 questions · delivered by email</span>
          </div>

          <div class="hero-ctas-dual">
            <a class="cta-card cta-primary" href="#order">
              <span class="cta-badge">Most popular</span>
              <span class="cta-kicker">New to Siddh Jyotish?</span>
              <span class="cta-heading">Create my Kundli &amp; ask 3 questions</span>
              <span class="cta-desc">Fill in your birth details, ask up to 3 questions, and get a complete Janma Kundli PDF plus personal answers — {kundliNow}.</span>
              <span class="cta-action cta-action-primary">Start my reading &darr;</span>
            </a>
            <a class="cta-card cta-secondary" href="/returning">
              <span class="cta-kicker">Already ordered before?</span>
              <span class="cta-heading">Ask additional questions</span>
              <span class="cta-desc">You'll have a reference number in the email from your last order — paste it in to ask 1–3 follow-up questions ({f1} / {f2} / {f3}). Your pandit picks up exactly where you left off.</span>
              <span class="cta-action cta-action-secondary">Ask additional questions &rarr;</span>
            </a>
          </div>

          <div class="question-chips" aria-label="Popular question examples">
            <span>When will I get married?</span>
            <span>When will I get a good job?</span>
            <span>When will we have a child?</span>
            <span>When will my health improve?</span>
            <span>Is this a good year to buy a home?</span>
          </div>
        </div>

        <div class="hero-visual" aria-hidden="true">
          <div class="hero-wheel-frame">
            <img src="/zodiac-wheel.png" alt="" class="hero-wheel" />
          </div>
        </div>
      </div>
    </section>
  </div>

  <div class="wrap">
    <section class="block">
      <div class="badges">
        <div class="badge">
          <div class="ico">🎯</div>
          <b>100% Accurate</b>
          <span>Precisely calculated placements — never guessed or hard-coded.</span>
        </div>
        <div class="badge">
          <div class="ico">🛡️</div>
          <b>100% Money-Back Guarantee</b>
          <span>Not satisfied with your report? We refund you in full.</span>
        </div>
        <div class="badge">
          <div class="ico">🕉️</div>
          <b>Respected Astrologers</b>
          <span>Prepared and personally reviewed by experienced Vedic pandits.</span>
        </div>
        <div class="badge">
          <div class="ico">🔒</div>
          <b>Private &amp; Secure</b>
          <span>No account needed. No data stored. Your reading stays yours.</span>
        </div>
      </div>
    </section>
  </div>

  <div class="wrap">
    <section class="block social-proof-strip">
      <div class="proof-stats">
        <div class="stat"><b>2,400+</b><span>readings delivered</span></div>
        <div class="stat"><b>99%</b><span>satisfaction rate</span></div>
        <div class="stat"><b>1 hr</b><span>average delivery</span></div>
      </div>
    </section>
  </div>

  <div class="wrap">
    <section class="block" id="how">
      <div class="section-head">
        <h2>How it works</h2>
        <p>Three simple steps. No account, no data kept on our side.</p>
      </div>
      <div class="steps">
        <div class="step">
          <div class="num">1</div>
          <h3>Share your birth details</h3>
          <p>Name, gender, exact date, time (with AM/PM), place of birth and its timezone. That's all your chart needs.</p>
        </div>
        <div class="step">
          <div class="num">2</div>
          <h3>A pandit prepares your chart</h3>
          <p>Your assigned astrologer computes the chart and writes an original, personal reading.</p>
        </div>
        <div class="step">
          <div class="num">3</div>
          <h3>Receive your report by email</h3>
          <p>A detailed PDF plus a private reference number — used to ask follow-up questions later.</p>
        </div>
      </div>
    </section>
  </div>

  <div class="wrap">
    <section class="block" id="about">
      <div class="section-head">
        <h2>About Siddh Jyotish</h2>
        <p>A living lineage. Precision you can trust.</p>
      </div>
      <div class="about-story">
        <div class="about-content">
          <p class="about-lead">
            <em>"Siddh"</em> means accomplished, proven — and that is precisely
            what we offer: <strong>proven astrology from a living lineage of
            scholars</strong>, not generic predictions from an algorithm.
          </p>
          <p>
            Our astrologers are <strong>Siddh Yogis</strong> who carry forward a
            centuries-old dual tradition — descended from a
            <strong>Kashmiri Pandit</strong> lineage and a
            <strong>Kerala Namboodiri Brahmin</strong> lineage of Jyotish
            scholars. These families have practised and refined Vedic astrology
            for generations, passing the knowledge of planetary computation, dasha
            interpretation, and remedial precision from guru to student without
            interruption.
          </p>
          <p>
            Every chart we produce is computed using a
            <strong>professional astronomical ephemeris</strong> (sidereal zodiac, Lahiri ayanamsa,
            whole-sign houses) — accurate to the arc-second. Nothing is estimated,
            approximated, or hard-coded. We pair computational precision with
            interpretive depth that only comes from lifetime immersion in
            <em>shastras</em>.
          </p>
          <p>
            We believe astrology should be an <strong>honest guide</strong> — not
            a fear-based upsell machine. You will never hear us say "pay more or
            face doom." Instead, you receive a candid, carefully-worded report
            that respects your intelligence and helps you make decisions with
            clarity.
          </p>
          <p class="about-promise">
            This is not a $5 horoscope app. This is a genuine consultation with a
            respected pandit — and we stand behind every reading with a
            <strong>100% money-back guarantee</strong>.
          </p>
        </div>
      </div>
    </section>
  </div>

  <div class="wrap">
    <section class="block order-section" id="order">
      <div class="section-head">
        <h2>Order your Siddh Jyotish Janma Kundli</h2>
        <p>Secure checkout via Stripe. Your report is emailed to you once ready.</p>
      </div>
      <div class="card card-accent narrow">
        <form id="kundli-form" novalidate>
          <div class="field">
            <label for="fullName">Full name</label>
            <input type="text" id="fullName" name="fullName" required autocomplete="name" />
            <p class="field-error" id="fullName-error" aria-live="polite"></p>
          </div>

          <div class="grid-2">
            <div class="field">
              <label for="gender">Gender</label>
              <select id="gender" name="gender" required>
                <option value="" disabled selected>Select…</option>
                <option value="Male">Male</option>
                <option value="Female">Female</option>
                <option value="Other">Other</option>
              </select>
              <p class="field-error" id="gender-error" aria-live="polite"></p>
            </div>
            <div class="field">
              <label for="dateOfBirth">Date of birth</label>
              <input type="date" id="dateOfBirth" name="dateOfBirth" min="1900-01-01" required />
              <p class="field-error" id="dateOfBirth-error" aria-live="polite"></p>
            </div>
          </div>

          <div class="field">
            <label for="timeOfBirth">Time of birth</label>
            <input type="time" id="timeOfBirth" name="timeOfBirth" required />
            <p class="field-error" id="timeOfBirth-error" aria-live="polite"></p>
          </div>

          <div class="field place-field">
            <label for="placeOfBirth">Place of birth</label>
            <div class="autocomplete-shell">
              <input type="text" id="placeOfBirth" name="placeOfBirth" placeholder="City, State, Country" required autocomplete="off" aria-autocomplete="list" aria-expanded="false" aria-controls="placeOfBirth-suggestions" />
              <div id="placeOfBirth-suggestions" class="autocomplete-list" role="listbox" aria-label="Place suggestions" hidden></div>
            </div>
            <p class="field-error" id="placeOfBirth-error" aria-live="polite"></p>
          </div>

          <div class="field">
            <label for="timezone">Timezone of birthplace</label>
            <select id="timezone" name="timezone" required>
              <option value="" disabled selected>Select the timezone of your birthplace…</option>
              <optgroup label="India &amp; South Asia">
                <option value="Asia/Kolkata">India — Asia/Kolkata (IST, UTC+5:30)</option>
                <option value="Asia/Karachi">Pakistan — Asia/Karachi (UTC+5)</option>
                <option value="Asia/Dhaka">Bangladesh — Asia/Dhaka (UTC+6)</option>
                <option value="Asia/Kathmandu">Nepal — Asia/Kathmandu (UTC+5:45)</option>
                <option value="Asia/Colombo">Sri Lanka — Asia/Colombo (UTC+5:30)</option>
                <option value="Asia/Thimphu">Bhutan — Asia/Thimphu (UTC+6)</option>
                <option value="Asia/Kabul">Afghanistan — Asia/Kabul (UTC+4:30)</option>
              </optgroup>
              <optgroup label="Middle East &amp; West Asia">
                <option value="Asia/Dubai">UAE — Asia/Dubai (UTC+4)</option>
                <option value="Asia/Riyadh">Saudi Arabia — Asia/Riyadh (UTC+3)</option>
                <option value="Asia/Qatar">Qatar — Asia/Qatar (UTC+3)</option>
                <option value="Asia/Kuwait">Kuwait — Asia/Kuwait (UTC+3)</option>
                <option value="Asia/Muscat">Oman — Asia/Muscat (UTC+4)</option>
                <option value="Asia/Tehran">Iran — Asia/Tehran (UTC+3:30)</option>
                <option value="Asia/Jerusalem">Israel — Asia/Jerusalem (UTC+2)</option>
              </optgroup>
              <optgroup label="East &amp; Southeast Asia">
                <option value="Asia/Shanghai">China — Asia/Shanghai (UTC+8)</option>
                <option value="Asia/Hong_Kong">Hong Kong — Asia/Hong_Kong (UTC+8)</option>
                <option value="Asia/Singapore">Singapore — Asia/Singapore (UTC+8)</option>
                <option value="Asia/Kuala_Lumpur">Malaysia — Asia/Kuala_Lumpur (UTC+8)</option>
                <option value="Asia/Jakarta">Indonesia (west) — Asia/Jakarta (UTC+7)</option>
                <option value="Asia/Bangkok">Thailand — Asia/Bangkok (UTC+7)</option>
                <option value="Asia/Ho_Chi_Minh">Vietnam — Asia/Ho_Chi_Minh (UTC+7)</option>
                <option value="Asia/Manila">Philippines — Asia/Manila (UTC+8)</option>
                <option value="Asia/Tokyo">Japan — Asia/Tokyo (UTC+9)</option>
                <option value="Asia/Seoul">South Korea — Asia/Seoul (UTC+9)</option>
              </optgroup>
              <optgroup label="Europe">
                <option value="Europe/London">UK / Ireland — Europe/London (UTC+0)</option>
                <option value="Europe/Paris">France — Europe/Paris (UTC+1)</option>
                <option value="Europe/Berlin">Germany — Europe/Berlin (UTC+1)</option>
                <option value="Europe/Madrid">Spain — Europe/Madrid (UTC+1)</option>
                <option value="Europe/Rome">Italy — Europe/Rome (UTC+1)</option>
                <option value="Europe/Amsterdam">Netherlands — Europe/Amsterdam (UTC+1)</option>
                <option value="Europe/Athens">Greece — Europe/Athens (UTC+2)</option>
                <option value="Europe/Istanbul">Turkey — Europe/Istanbul (UTC+3)</option>
                <option value="Europe/Moscow">Russia (Moscow) — Europe/Moscow (UTC+3)</option>
              </optgroup>
              <optgroup label="Africa">
                <option value="Africa/Lagos">Nigeria — Africa/Lagos (UTC+1)</option>
                <option value="Africa/Cairo">Egypt — Africa/Cairo (UTC+2)</option>
                <option value="Africa/Johannesburg">South Africa — Africa/Johannesburg (UTC+2)</option>
                <option value="Africa/Nairobi">Kenya — Africa/Nairobi (UTC+3)</option>
                <option value="Indian/Mauritius">Mauritius — Indian/Mauritius (UTC+4)</option>
              </optgroup>
              <optgroup label="North America">
                <option value="America/New_York">US Eastern — America/New_York (UTC−5)</option>
                <option value="America/Chicago">US Central — America/Chicago (UTC−6)</option>
                <option value="America/Denver">US Mountain — America/Denver (UTC−7)</option>
                <option value="America/Los_Angeles">US Pacific — America/Los_Angeles (UTC−8)</option>
                <option value="America/Toronto">Canada Eastern — America/Toronto (UTC−5)</option>
                <option value="America/Vancouver">Canada Pacific — America/Vancouver (UTC−8)</option>
                <option value="America/Mexico_City">Mexico — America/Mexico_City (UTC−6)</option>
              </optgroup>
              <optgroup label="Central &amp; South America">
                <option value="America/Sao_Paulo">Brazil (São Paulo) — America/Sao_Paulo (UTC−3)</option>
                <option value="America/Argentina/Buenos_Aires">Argentina — America/Argentina/Buenos_Aires (UTC−3)</option>
                <option value="America/Bogota">Colombia — America/Bogota (UTC−5)</option>
                <option value="America/Lima">Peru — America/Lima (UTC−5)</option>
                <option value="America/Santiago">Chile — America/Santiago (UTC−4)</option>
              </optgroup>
              <optgroup label="Oceania">
                <option value="Australia/Sydney">Australia Eastern — Australia/Sydney (UTC+10)</option>
                <option value="Australia/Perth">Australia Western — Australia/Perth (UTC+8)</option>
                <option value="Pacific/Auckland">New Zealand — Pacific/Auckland (UTC+12)</option>
                <option value="Pacific/Fiji">Fiji — Pacific/Fiji (UTC+12)</option>
              </optgroup>
              <optgroup label="Other">
                <option value="UTC">UTC (Coordinated Universal Time)</option>
              </optgroup>
            </select>
            <p class="helper" style="margin-top:0.35rem">The timezone of the town/city where you were born — not where you live now.</p>
            <p class="field-error" id="timezone-error" aria-live="polite"></p>
          </div>

          <div class="field">
            <label for="email">Email</label>
            <input type="email" id="email" name="email" required autocomplete="email" />
            <p class="field-error" id="email-error" aria-live="polite"></p>
          </div>

          <div class="field">
            <label for="q1">3 questions included with your report (max 18 words each)</label>
            <input type="text" id="q1" name="q1" placeholder="When will I get married?" />
            <p class="field-error" id="q1-error" aria-live="polite"></p>
            <input type="text" id="q2" name="q2" placeholder="When will I get a good job / promotion?" style="margin-top:0.5rem" />
            <p class="field-error" id="q2-error" aria-live="polite"></p>
            <input type="text" id="q3" name="q3" placeholder="When will we be blessed with a child?" style="margin-top:0.5rem" />
            <p class="field-error" id="q3-error" aria-live="polite"></p>
          </div>

          <button type="submit" id="submit-btn" class="btn btn-block"><s class="was-btn">{kundliWas}</s> Pay {kundliNow} &amp; Get Kundli Report and Answers</button>
          <div id="error" class="error" hidden></div>
          <p class="helper center" style="margin-top:1rem">🔒 Secure Stripe checkout · 100% money-back guarantee</p>
        </form>
      </div>
      <p class="center gifting-note">
        <strong>Gifting a reading?</strong> Enter your loved one's birth details
        and your own email — we'll send the report to you so you can present it
        yourself.
      </p>
    </section>
  </div>

  <div class="wrap">
    <section class="block">
      <div class="section-head">
        <h2>Trusted by seekers worldwide</h2>
      </div>
      <div class="testimonials">
        <div class="quote">
          <div class="stars">★★★★★</div>
          <p>"The timing predictions were uncannily accurate. The report read like it was written just for me."</p>
          <div class="who">— Priya M., Toronto</div>
        </div>
        <div class="quote">
          <div class="stars">★★★★★</div>
          <p>"Detailed, precise and beautifully explained. Worth every rupee — and the follow-up answers were superb."</p>
          <div class="who">— Arjun R., London</div>
        </div>
        <div class="quote">
          <div class="stars">★★★★★</div>
          <p>"I finally understood my dasha periods. The remedies were practical and specific to my chart."</p>
          <div class="who">— Neha S., Bengaluru</div>
        </div>
        <div class="quote">
          <div class="stars">★★★★★</div>
          <p>"My mother was moved to tears. It was the most personal gift I could give her."</p>
          <div class="who">— Anita K., New Jersey</div>
        </div>
      </div>
    </section>
  </div>

  <div class="wrap">
    <section class="block" id="faq">
      <div class="section-head">
        <h2>Frequently asked questions</h2>
      </div>
      <div class="faq">
        <details open>
          <summary>How accurate is the chart?</summary>
          <p>Every planetary position is computed with a professional astronomical ephemeris (sidereal zodiac, Lahiri ayanamsa, whole-sign houses) — accurate to the arc-second. Nothing is estimated or hard-coded.</p>
        </details>
        <details>
          <summary>What do I receive, and when?</summary>
          <p>A detailed multi-page PDF report emailed to you once your assigned pandit completes it, along with an encrypted reference number for future follow-up questions.</p>
        </details>
        <details>
          <summary>Do I need an account?</summary>
          <p>No. We keep no account and store no personal data on our side — your reading is private. Your reference number is your key to follow-ups.</p>
        </details>
        <details>
          <summary>What is the money-back guarantee?</summary>
          <p>If you're not satisfied with your report, contact us and we'll refund you in full. We stand behind the quality of every reading.</p>
        </details>
        <details>
          <summary>Why is the time of birth so important?</summary>
          <p>Your ascendant (Lagna) changes roughly every two hours, reshaping the entire chart. An accurate time — including AM/PM — is essential.</p>
        </details>
        <details>
          <summary>Can I gift this to someone?</summary>
          <p>Absolutely. Enter your loved one's birth details and your own email. You'll receive the report so you can present it personally — a truly meaningful and personal gift.</p>
        </details>
      </div>
      <p class="center" style="margin-top:1.5rem">
        Already have a reference number?
        <a href="/returning">Ask follow-up questions →</a>
      </p>
    </section>
  </div>

  <div class="wrap">
    <section class="block final-cta-section">
      <div class="final-cta-box">
        <h2>Your chart is waiting to be read.</h2>
        <p>
          Whether you're seeking career clarity, timing a life decision, or
          gifting insight to a loved one — a precise Janma Kundli from Siddh
          Jyotish gives you the guide you deserve.
        </p>
        <div class="final-cta-actions">
          <a class="btn" href="#order">Get my Kundli — {kundliNow}</a>
          <a class="btn btn-ghost-dark" href="/returning">I have a reference — ask questions</a>
        </div>
        <p class="final-cta-reassure">100% money-back guarantee · No account needed · Delivered by email</p>
      </div>
    </section>
  </div>
</Base>

<style>
  /* Hero split */
  .hero-split { padding-bottom: clamp(2.2rem, 5vw, 4rem); }
  .hero-grid {
    display: grid;
    grid-template-columns: minmax(0, 1.1fr) minmax(280px, 0.9fr);
    gap: clamp(1.5rem, 4vw, 3rem);
    align-items: center;
  }
  .wrap-wide {
    max-width: 1240px;
  }
  .hero-copy { position: relative; z-index: 1; }
  .hero-visual {
    position: relative;
    min-height: 420px;
    display: grid;
    place-items: center;
  }
  .hero-wheel-frame {
    position: relative;
    width: min(100%, 460px);
    aspect-ratio: 1;
    display: grid;
    place-items: center;
    border-radius: 50%;
    padding: 10px;
    background:
      radial-gradient(circle at center, rgba(255, 239, 191, 0.14) 0%, rgba(255, 239, 191, 0.08) 58%, rgba(255, 239, 191, 0) 74%),
      linear-gradient(145deg, rgba(233, 196, 109, 0.96), rgba(201, 162, 39, 0.9));
    box-shadow:
      0 0 0 1px rgba(255, 236, 193, 0.35) inset,
      0 0 0 7px rgba(255, 236, 193, 0.06) inset,
      0 18px 40px rgba(10, 10, 30, 0.28),
      0 0 45px rgba(201, 162, 39, 0.16);
    overflow: hidden;
  }
  .hero-wheel {
    width: 100%;
    height: auto;
    display: block;
    border-radius: 50%;
    box-shadow: inset 0 0 0 1px rgba(255,255,255,0.08);
    animation: spin 120s linear infinite;
    -webkit-mask-image: radial-gradient(circle, #000 0 74%, rgba(0, 0, 0, 0.9) 80%, transparent 100%);
    mask-image: radial-gradient(circle, #000 0 74%, rgba(0, 0, 0, 0.9) 80%, transparent 100%);
  }
  @keyframes spin {
    from { transform: rotate(0deg); }
    to { transform: rotate(360deg); }
  }
  @media (prefers-reduced-motion: reduce) {
    .hero-wheel { animation: none; }
  }
  .hero .lead { color: #ecdfff; font-size: clamp(1.05rem, 2.4vw, 1.3rem); max-width: 40ch; }
  .hero .price-tag { margin-bottom: 1.2rem; }
  .eyebrow {
    display: inline-block; font-family: var(--sans); font-weight: 600;
    letter-spacing: 2px; text-transform: uppercase; font-size: 0.8rem;
    color: var(--gold-soft); margin-bottom: 1rem;
  }
  .price-tag {
    display: inline-flex; align-items: baseline; gap: 0.5rem; margin: 0.5rem 0 1.5rem;
  }
  .price-tag b { font-family: var(--serif); font-size: 2rem; color: #fff; }
  .price-tag span { color: #d9ccff; font-size: 0.95rem; }
  .was { color: #b9a6e6; text-decoration: line-through; font-size: 1.25rem; opacity: 0.75; }
  .was-btn { color: inherit; opacity: 0.7; text-decoration: line-through; margin-right: 0.35rem; font-weight: 600; }

  /* ---------- Buttons ---------- */
  .btn {
    display: inline-block; text-align: center; cursor: pointer;
    font-family: var(--sans); font-weight: 700; font-size: 1.05rem;
    color: var(--indigo); border: none; border-radius: 999px;
    padding: 0.9rem 1.8rem;
    background: linear-gradient(180deg, var(--gold-soft), var(--gold));
    box-shadow: 0 8px 22px rgba(201,162,39,0.4);
    transition: transform 0.16s ease, box-shadow 0.16s ease, background 0.16s ease, color 0.16s ease, border-color 0.16s ease;
  }
  .btn:hover { transform: translateY(-1px); text-decoration: none; box-shadow: 0 12px 28px rgba(201,162,39,0.5); }
  .btn:disabled { opacity: 0.6; cursor: not-allowed; transform: none; }
  .btn-block { display: block; width: 100%; margin-top: 1.5rem; }
  .btn-ghost {
    background: transparent; color: #fff; border: 1.5px solid rgba(255,255,255,0.5);
    box-shadow: none;
  }
  .btn-ghost:hover { background: rgba(255,255,255,0.1); }
  .btn-outline {
    background: transparent;
    color: var(--maroon);
    border: 1.5px solid var(--maroon);
    box-shadow: none;
  }
  .btn-outline:hover {
