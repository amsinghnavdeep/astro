---
import Base from '../layouts/Base.astro';
---

<Base title="Siddh Jyotish — Your Vedic Birth Chart, Created with Precision">
  <div class="wrap wrap-wide">
    <section class="hero hero-split">
      <div class="hero-grid">
        <div class="hero-copy">
          <span class="eyebrow">Siddh Jyotish · Prepared by respected and siddh astrologers</span>
          <h1>Your Janma Kundli, created &amp; analysed by hand.</h1>
          <p class="lead" style="max-width:56ch">
            Not a generic horoscope. A genuine Vedic birth chart, cast from your exact birth details and interpreted by hand. <strong>Know your path with clarity and precision.</strong>
          </p>
          <div class="price-tag">
            <s class="was">$51</s> <b>$31</b><span>· complete Kundli + 3 questions · delivered by email</span>
          </div>

          <div class="hero-ctas-dual">
            <a class="cta-card cta-primary" href="#order">
              <span class="cta-badge">Most popular</span>
              <span class="cta-kicker">New to Siddh Jyotish?</span>
              <span class="cta-heading">Create my Kundli &amp; ask 3 questions</span>
              <span class="cta-desc">Fill in your birth details, ask up to 3 questions, and get a complete Janma Kundli PDF plus personal answers — $31.</span>
              <span class="cta-action cta-action-primary">Start my reading &darr;</span>
            </a>
            <a class="cta-card cta-secondary" href="/returning">
              <span class="cta-kicker">Already ordered before?</span>
              <span class="cta-heading">Ask additional questions</span>
              <span class="cta-desc">You'll have a reference number in the email from your last order — paste it in to ask 1–3 follow-up questions ($8 / $11 / $13). Your pandit picks up exactly where you left off.</span>
              <span class="cta-action cta-action-secondary">Ask additional questions &rarr;</span>
            </a>
          </div>

          <div class="question-chips" aria-label="Popular question examples">
            <span>When will I get married?</span>
            <span>When will I get a good job?</span>
            <span>When will we have a child?</span>
            <span>When will my health improve?</span>
            <span>Is this a good year to buy a home?</span>
          </div>
        </div>

        <div class="hero-visual" aria-hidden="true">
          <div class="hero-wheel-frame">
            <img src="/zodiac-wheel.png" alt="" class="hero-wheel" />
          </div>
        </div>
      </div>
    </section>
  </div>

  <div class="wrap">
    <section class="block">
      <div class="badges">
        <div class="badge">
          <div class="ico">🎯</div>
          <b>100% Accurate</b>
          <span>Precisely calculated placements — never guessed or hard-coded.</span>
        </div>
        <div class="badge">
          <div class="ico">🛡️</div>
          <b>100% Money-Back Guarantee</b>
          <span>Not satisfied with your report? We refund you in full.</span>
        </div>
        <div class="badge">
          <div class="ico">🕉️</div>
          <b>Respected Astrologers</b>
          <span>Prepared and personally reviewed by experienced Vedic pandits.</span>
        </div>
        <div class="badge">
          <div class="ico">🔒</div>
          <b>Private &amp; Secure</b>
          <span>No account needed. No data stored. Your reading stays yours.</span>
        </div>
      </div>
    </section>
  </div>

  <div class="wrap">
    <section class="block social-proof-strip">
      <div class="proof-stats">
        <div class="stat"><b>2,400+</b><span>readings delivered</span></div>
        <div class="stat"><b>99%</b><span>satisfaction rate</span></div>
        <div class="stat"><b>1 hr</b><span>average delivery</span></div>
      </div>
    </section>
  </div>

  <div class="wrap">
    <section class="block" id="how">
      <div class="section-head">
        <h2>How it works</h2>
        <p>Three simple steps. No account, no data kept on our side.</p>
      </div>
      <div class="steps">
        <div class="step">
          <div class="num">1</div>
          <h3>Share your birth details</h3>
          <p>Name, gender, exact date, time (with AM/PM) and place of birth. That's all your chart needs.</p>
        </div>
        <div class="step">
          <div class="num">2</div>
          <h3>A pandit prepares your chart</h3>
          <p>Your assigned astrologer computes the chart and writes an original, personal reading.</p>
        </div>
        <div class="step">
          <div class="num">3</div>
          <h3>Receive your report by email</h3>
          <p>A detailed PDF plus a private reference number — used to ask follow-up questions later.</p>
        </div>
      </div>
    </section>
  </div>

  <div class="wrap">
    <section class="block" id="about">
      <div class="section-head">
        <h2>About Siddh Jyotish</h2>
        <p>A living lineage. Precision you can trust.</p>
      </div>
      <div class="about-story">
        <div class="about-content">
          <p class="about-lead">
            <em>"Siddh"</em> means accomplished, proven — and that is precisely
            what we offer: <strong>proven astrology from a living lineage of
            scholars</strong>, not generic predictions from an algorithm.
          </p>
          <p>
            Our astrologers are <strong>Siddh Yogis</strong> who carry forward a
            centuries-old dual tradition — descended from a
            <strong>Kashmiri Pandit</strong> lineage and a
            <strong>Kerala Namboodiri Brahmin</strong> lineage of Jyotish
            scholars. These families have practised and refined Vedic astrology
            for generations, passing the knowledge of planetary computation, dasha
            interpretation, and remedial precision from guru to student without
            interruption.
          </p>
          <p>
            Every chart we produce is computed using the
            <strong>Swiss Ephemeris</strong> (sidereal zodiac, Lahiri ayanamsa,
            whole-sign houses) — accurate to the arc-second. Nothing is estimated,
            approximated, or hard-coded. We pair computational precision with
            interpretive depth that only comes from lifetime immersion in
            <em>shastras</em>.
          </p>
          <p>
            We believe astrology should be an <strong>honest guide</strong> — not
            a fear-based upsell machine. You will never hear us say "pay more or
            face doom." Instead, you receive a candid, carefully-worded report
            that respects your intelligence and helps you make decisions with
            clarity.
          </p>
          <p class="about-promise">
            This is not a $5 horoscope app. This is a genuine consultation with a
            respected pandit — and we stand behind every reading with a
            <strong>100% money-back guarantee</strong>.
          </p>
        </div>
      </div>
    </section>
  </div>

  <div class="wrap">
    <section class="block order-section" id="order">
      <div class="section-head">
        <h2>Order your Siddh Jyotish Janma Kundli</h2>
        <p>Secure checkout via Stripe. Your report is emailed to you once ready.</p>
      </div>
      <div class="card card-accent narrow">
        <form id="kundli-form">
          <label for="fullName">Full name</label>
          <input type="text" id="fullName" name="fullName" required autocomplete="name" />

          <div class="grid-2">
            <div>
              <label for="gender">Gender</label>
              <select id="gender" name="gender" required>
                <option value="" disabled selected>Select…</option>
                <option value="Male">Male</option>
                <option value="Female">Female</option>
                <option value="Other">Other</option>
              </select>
            </div>
            <div>
              <label for="dateOfBirth">Date of birth</label>
              <input type="text" id="dateOfBirth" name="dateOfBirth" placeholder="30 Jan 2000" required />
            </div>
          </div>

          <label for="timeOfBirth">Time of birth</label>
          <input type="text" id="timeOfBirth" name="timeOfBirth" placeholder="11:30 AM" required />
          <p class="helper">Please include AM/PM — it materially changes your chart.</p>

          <label for="placeOfBirth">Place of birth</label>
          <input type="text" id="placeOfBirth" name="placeOfBirth" placeholder="City, State, Country" required />

          <label for="email">Email</label>
          <input type="email" id="email" name="email" required autocomplete="email" />

          <label for="q1">3 questions included with your report (max 18 words each)</label>
          <input type="text" id="q1" name="q1" placeholder="When will I get married?" />
          <input type="text" id="q2" name="q2" placeholder="When will I get a good job / promotion?" style="margin-top:0.5rem" />
          <input type="text" id="q3" name="q3" placeholder="When will we be blessed with a child?" style="margin-top:0.5rem" />

          <button type="submit" id="submit-btn" class="btn btn-block"><s class="was-btn">$51</s> Pay $31 &amp; Get Kundli Report and Answers</button>
          <div id="error" class="error" hidden></div>
          <p class="helper center" style="margin-top:1rem">🔒 Secure Stripe checkout · 100% money-back guarantee</p>
        </form>
      </div>
      <p class="center gifting-note">
        <strong>Gifting a reading?</strong> Enter your loved one's birth details
        and your own email — we'll send the report to you so you can present it
        yourself.
      </p>
    </section>
  </div>

  <div class="wrap">
    <section class="block">
      <div class="section-head">
        <h2>Trusted by seekers worldwide</h2>
      </div>
      <div class="testimonials">
        <div class="quote">
          <div class="stars">★★★★★</div>
          <p>"The timing predictions were uncannily accurate. The report read like it was written just for me."</p>
          <div class="who">— Priya M., Toronto</div>
        </div>
        <div class="quote">
          <div class="stars">★★★★★</div>
          <p>"Detailed, precise and beautifully explained. Worth every rupee — and the follow-up answers were superb."</p>
          <div class="who">— Arjun R., London</div>
        </div>
        <div class="quote">
          <div class="stars">★★★★★</div>
          <p>"I finally understood my dasha periods. The remedies were practical and specific to my chart."</p>
          <div class="who">— Neha S., Bengaluru</div>
        </div>
        <div class="quote">
          <div class="stars">★★★★★</div>
          <p>"My mother was moved to tears. It was the most personal gift I could give her."</p>
          <div class="who">— Anita K., New Jersey</div>
        </div>
      </div>
    </section>
  </div>

  <div class="wrap">
    <section class="block" id="faq">
      <div class="section-head">
        <h2>Frequently asked questions</h2>
      </div>
      <div class="faq">
        <details open>
          <summary>How accurate is the chart?</summary>
          <p>Every planetary position is computed with the Swiss Ephemeris (sidereal zodiac, Lahiri ayanamsa, whole-sign houses) — accurate to the arc-second. Nothing is estimated or hard-coded.</p>
        </details>
        <details>
          <summary>What do I receive, and when?</summary>
          <p>A detailed multi-page PDF report emailed to you once your assigned pandit completes it, along with an encrypted reference number for future follow-up questions.</p>
        </details>
        <details>
          <summary>Do I need an account?</summary>
          <p>No. We keep no account and store no personal data on our side — your reading is private. Your reference number is your key to follow-ups.</p>
        </details>
        <details>
          <summary>What is the money-back guarantee?</summary>
          <p>If you're not satisfied with your report, contact us and we'll refund you in full. We stand behind the quality of every reading.</p>
        </details>
        <details>
          <summary>Why is the time of birth so important?</summary>
          <p>Your ascendant (Lagna) changes roughly every two hours, reshaping the entire chart. An accurate time — including AM/PM — is essential.</p>
        </details>
        <details>
          <summary>Can I gift this to someone?</summary>
          <p>Absolutely. Enter your loved one's birth details and your own email. You'll receive the report so you can present it personally — a truly meaningful and personal gift.</p>
        </details>
      </div>
      <p class="center" style="margin-top:1.5rem">
        Already have a reference number?
        <a href="/returning">Ask follow-up questions →</a>
      </p>
    </section>
  </div>

  <div class="wrap">
    <section class="block final-cta-section">
      <div class="final-cta-box">
        <h2>Your chart is waiting to be read.</h2>
        <p>
          Whether you're seeking career clarity, timing a life decision, or
          gifting insight to a loved one — a precise Janma Kundli from Siddh
          Jyotish gives you the guide you deserve.
        </p>
        <div class="final-cta-actions">
          <a class="btn" href="#order">Get my Kundli — $31</a>
          <a class="btn btn-ghost-dark" href="/returning">I have a reference — ask questions</a>
        </div>
        <p class="final-cta-reassure">100% money-back guarantee · No account needed · Delivered by email</p>
      </div>
    </section>
  </div>
</Base>

<style>
  /* Hero split */
  .hero-split { padding-bottom: clamp(2.2rem, 5vw, 4rem); }
  .hero-grid {
    display: grid;
    grid-template-columns: minmax(0, 1.1fr) minmax(280px, 0.9fr);
    gap: clamp(1.5rem, 4vw, 3rem);
    align-items: center;
  }
  .wrap-wide {
    max-width: 1240px;
  }
  .hero-copy { position: relative; z-index: 1; }
  .hero-visual {
    position: relative;
    min-height: 420px;
    display: grid;
    place-items: center;
  }
  .hero-wheel-frame {
    position: relative;
    width: min(100%, 460px);
    aspect-ratio: 1;
    display: grid;
    place-items: center;
    border-radius: 50%;
    padding: 10px;
    background:
      radial-gradient(circle at center, rgba(255, 239, 191, 0.14) 0%, rgba(255, 239, 191, 0.08) 58%, rgba(255, 239, 191, 0) 74%),
      linear-gradient(145deg, rgba(233, 196, 109, 0.96), rgba(201, 162, 39, 0.9));
    box-shadow:
      0 0 0 1px rgba(255, 236, 193, 0.35) inset,
      0 0 0 7px rgba(255, 236, 193, 0.06) inset,
      0 18px 40px rgba(10, 10, 30, 0.28),
      0 0 45px rgba(201, 162, 39, 0.16);
    overflow: hidden;
  }
  .hero-wheel {
    width: 100%;
    height: auto;
    display: block;
    border-radius: 50%;
    box-shadow: inset 0 0 0 1px rgba(255,255,255,0.08);
    animation: spin 120s linear infinite;
    -webkit-mask-image: radial-gradient(circle, #000 0 74%, rgba(0, 0, 0, 0.9) 80%, transparent 100%);
    mask-image: radial-gradient(circle, #000 0 74%, rgba(0, 0, 0, 0.9) 80%, transparent 100%);
  }
  @keyframes spin {
    from { transform: rotate(0deg); }
    to { transform: rotate(360deg); }
  }
  @media (prefers-reduced-motion: reduce) {
    .hero-wheel { animation: none; }
  }
  .hero .lead { color: #ecdfff; font-size: clamp(1.05rem, 2.4vw, 1.3rem); max-width: 40ch; }
  .hero .price-tag { margin-bottom: 1.2rem; }
  .eyebrow {
    display: inline-block; font-family: var(--sans); font-weight: 600;
    letter-spacing: 2px; text-transform: uppercase; font-size: 0.8rem;
    color: var(--gold-soft); margin-bottom: 1rem;
  }
  .price-tag {
    display: inline-flex; align-items: baseline; gap: 0.5rem; margin: 0.5rem 0 1.5rem;
  }
  .price-tag b { font-family: var(--serif); font-size: 2rem; color: #fff; }
  .price-tag span { color: #d9ccff; font-size: 0.95rem; }
  .was { color: #b9a6e6; text-decoration: line-through; font-size: 1.25rem; opacity: 0.75; }
  .was-btn { color: inherit; opacity: 0.7; text-decoration: line-through; margin-right: 0.35rem; font-weight: 600; }

  /* ---------- Buttons ---------- */
  .btn {
    display: inline-block; text-align: center; cursor: pointer;
    font-family: var(--sans); font-weight: 700; font-size: 1.05rem;
    color: var(--indigo); border: none; border-radius: 999px;
    padding: 0.9rem 1.8rem;
    background: linear-gradient(180deg, var(--gold-soft), var(--gold));
    box-shadow: 0 8px 22px rgba(201,162,39,0.4);
    transition: transform 0.16s ease, box-shadow 0.16s ease, background 0.16s ease, color 0.16s ease, border-color 0.16s ease;
  }
  .btn:hover { transform: translateY(-1px); text-decoration: none; box-shadow: 0 12px 28px rgba(201,162,39,0.5); }
  .btn:disabled { opacity: 0.6; cursor: not-allowed; transform: none; }
  .btn-block { display: block; width: 100%; margin-top: 1.5rem; }
  .btn-ghost {
    background: transparent; color: #fff; border: 1.5px solid rgba(255,255,255,0.5);
    box-shadow: none;
  }
  .btn-ghost:hover { background: rgba(255,255,255,0.1); }
  .btn-outline {
    background: transparent;
    color: var(--maroon);
    border: 1.5px solid var(--maroon);
    box-shadow: none;
  }
  .btn-outline:hover {
    background: rgba(122, 30, 30, 0.08);
    color: var(--maroon-deep);
    text-decoration: none;
  }
  .hero-ctas-dual { display: grid; grid-template-columns: 1fr 1fr; gap: 1rem; margin-top: 1.2rem; }
  .cta-card {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
    padding: 1.4rem 1.3rem;
    border-radius: 18px;
    text-decoration: none;
    position: relative;
    overflow: visible;
    transition: transform 0.18s ease, box-shadow 0.18s ease, background 0.18s ease, color 0.18s ease, border-color 0.18s ease;
  }
  .cta-card:hover { transform: translateY(-2px); text-decoration: none; }
  .cta-badge {
    position: absolute;
    top: -0.5rem;
    right: 1rem;
    background: var(--maroon);
    color: #fff;
    font-size: 0.75rem;
    font-weight: 700;
    padding: 0.25rem 0.7rem;
    border-radius: 999px;
    text-transform: uppercase;
    letter-spacing: 0.5px;
  }
  .cta-kicker {
    display: inline-flex;
    align-self: flex-start;
    border-radius: 999px;
    padding: 0.28rem 0.7rem;
    font-size: 0.76rem;
    font-weight: 700;
    letter-spacing: 0.4px;
    text-transform: uppercase;
  }
  .cta-primary {
    background: linear-gradient(145deg, var(--green), var(--green-2));
    color: #fff;
    box-shadow: 0 14px 30px rgba(31, 122, 77, 0.34), 0 0 0 1px rgba(255,255,255,0.08) inset;
  }
  .cta-primary .cta-kicker {
    background: rgba(255,255,255,0.14);
    color: #f2fff7;
  }
  .cta-primary .cta-desc,
  .cta-primary .cta-heading { color: #fff; }
  .cta-primary .cta-heading { text-shadow: 0 1px 0 rgba(0,0,0,0.08); }
  .cta-primary:hover { box-shadow: 0 18px 38px rgba(31, 122, 77, 0.42), 0 0 0 1px rgba(255,255,255,0.08) inset; }
  .cta-secondary {
    background: linear-gradient(145deg, #ffd47a, #f3a838 62%, #ffbf4d);
    border: 1px solid rgba(255, 255, 255, 0.25);
    color: var(--indigo);
    box-shadow: 0 14px 30px rgba(224, 129, 47, 0.22);
  }
  .cta-secondary .cta-kicker {
    background: rgba(42, 31, 92, 0.1);
    color: var(--indigo);
  }
  .cta-secondary .cta-heading,
  .cta-secondary .cta-desc { color: var(--indigo); }
  .cta-secondary:hover { box-shadow: 0 18px 36px rgba(224,129,47,0.28); }
  .cta-heading {
    font-family: var(--serif);
    font-size: 1.15rem;
    font-weight: 600;
    line-height: 1.3;
  }
  .cta-desc {
    font-size: 0.92rem;
    opacity: 0.9;
    line-height: 1.55;
  }
  .cta-action {
    font-weight: 700;
    font-size: 0.96rem;
    margin-top: auto;
    align-self: flex-start;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    padding: 0.72rem 1rem;
    border-radius: 999px;
    box-shadow: 0 8px 18px rgba(0,0,0,0.12);
    transition: transform 0.18s ease, box-shadow 0.18s ease, background 0.18s ease, color 0.18s ease;
  }
  .cta-action-primary {
    background: linear-gradient(180deg, #fff8e6, #f4dea0);
    color: var(--indigo);
  }
  .cta-action-secondary {
    background: linear-gradient(180deg, var(--indigo), var(--maroon-deep));
    color: #fff;
  }
  .cta-card:hover .cta-action {
    transform: translateY(-1px);
    box-shadow: 0 10px 22px rgba(0,0,0,0.16);
  }
  .question-chips {
    display: flex;
    flex-wrap: wrap;
    gap: 0.6rem;
    margin-top: 1rem;
  }
  .question-chips span {
    display: inline-flex;
    align-items: center;
    padding: 0.46rem 0.8rem;
    border-radius: 999px;
    background: rgba(255, 255, 255, 0.12);
    border: 1px solid rgba(255, 255, 255, 0.16);
    color: #f7efe0;
    font-size: 0.88rem;
    line-height: 1.2;
  }
  @media (max-width: 900px) {
    .hero-grid { grid-template-columns: 1fr; }
    .hero-visual { display: none; }
  }
  @media (max-width: 680px) {
    .hero-ctas-dual { grid-template-columns: 1fr; }
  }

  /* Social proof strip */
  .social-proof-strip { padding: 1.5rem 0 !important; }
  .proof-stats {
    display: flex;
    justify-content: center;
    gap: 3rem;
    flex-wrap: wrap;
  }
  .stat { text-align: center; }
  .stat b {
    display: block;
    font-family: var(--serif);
    font-size: 1.6rem;
    color: var(--maroon);
  }
  .stat span { color: var(--muted); font-size: 0.9rem; }

  /* About section */
  .about-story {
    max-width: 700px;
    margin: 0 auto;
  }
  .about-content p {
    font-size: 1.05rem;
    line-height: 1.75;
    color: var(--text);
  }
  .about-lead {
    font-family: var(--serif-2);
    font-size: 1.25rem !important;
    color: var(--maroon) !important;
    border-left: 3px solid var(--gold);
    padding-left: 1rem;
    margin-bottom: 1.5rem !important;
  }
  .about-promise {
    background: linear-gradient(135deg, #fff7e6, #fef5dd);
    border: 1px solid var(--border);
    border-radius: 12px;
    padding: 1rem 1.2rem;
    margin-top: 1.5rem !important;
  }

  /* Order section background */
  .order-section {
    background: url('/astro-bg.png') center/cover no-repeat;
    border-radius: 24px;
    padding-top: clamp(2.4rem, 5vw, 3.3rem);
    padding-bottom: clamp(2.4rem, 5vw, 3.3rem);
  }
  .order-section .section-head,
  .order-section .gifting-note {
    position: relative;
    z-index: 1;
  }
  .order-section .card {
    position: relative;
    z-index: 1;
    background: var(--card);
  }

  /* Gifting note */
  .gifting-note {
    color: var(--muted);
    font-size: 0.95rem;
    margin-top: 1.2rem;
  }

  /* Final CTA section */
  .final-cta-section { padding-bottom: 1rem !important; }
  .final-cta-box {
    text-align: center;
    background:
      radial-gradient(600px 250px at 50% 0, rgba(243,168,56,0.15), transparent),
      linear-gradient(160deg, var(--indigo) 0%, var(--indigo-2) 55%, #3a2a72 100%);
    color: #f0e6ff;
    border-radius: 22px;
    padding: clamp(2rem, 5vw, 3.5rem) clamp(1.4rem, 4vw, 3rem);
  }
  .final-cta-box h2 { color: #fff; }
  .final-cta-box p { color: #d9ccff; max-width: 52ch; margin: 0 auto 1.2rem; }
  .final-cta-actions {
    display: flex;
    justify-content: center;
    gap: 0.8rem;
    flex-wrap: wrap;
    margin: 1.5rem 0 1rem;
  }
  .btn-ghost-dark {
    background: transparent;
    color: #fff;
    border: 1.5px solid rgba(255,255,255,0.4);
    box-shadow: none;
  }
  .btn-ghost-dark:hover { background: rgba(255,255,255,0.1); text-decoration: none; }
  .final-cta-reassure { font-size: 0.88rem; color: #a99fd6 !important; margin-top: 0.5rem !important; }
</style>

<script>
  const form = document.getElementById('kundli-form') as HTMLFormElement;
  const btn = document.getElementById('submit-btn') as HTMLButtonElement;
  const errorEl = document.getElementById('error') as HTMLDivElement;

  function showError(message: string) {
    errorEl.textContent = message;
    errorEl.hidden = false;
  }

  function value(id: string): string {
    const el = document.getElementById(id) as HTMLInputElement | HTMLSelectElement | null;
    return (el?.value ?? '').trim();
  }

  form.addEventListener('submit', async (event) => {
    event.preventDefault();
    errorEl.hidden = true;

    const questions = ['q1', 'q2', 'q3']
      .map((id) => value(id))
      .filter((q) => q.length > 0);

    const tooLong = questions.find((q) => q.split(/\s+/).length > 18);
    if (tooLong) {
      showError('Each question must be 18 words or fewer.');
      return;
    }

    const payload = {
      fullName: value('fullName'),
      gender: value('gender'),
      dateOfBirth: value('dateOfBirth'),
      timeOfBirth: value('timeOfBirth'),
      placeOfBirth: value('placeOfBirth'),
      email: value('email'),
      questions,
    };

    if (!payload.gender) {
      showError('Please select your gender.');
      return;
    }

    btn.disabled = true;
    const originalText = btn.textContent;
    btn.textContent = 'Redirecting to secure checkout…';

    try {
      const res = await fetch('/api/checkout/new', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify(payload),
      });

      const data = await res.json().catch(() => ({}));

      if (res.status === 200 && data && typeof data.url === 'string') {
        window.location.href = data.url;
        return;
      }

      showError((data && data.error) || 'Something went wrong. Please check your details and try again.');
    } catch {
      showError('Network error. Please try again.');
    } finally {
      btn.disabled = false;
      btn.textContent = originalText;
    }
  });
</script>
