---
import Base from '../layouts/Base.astro';
import Icon from '../components/Icon.astro';
import { detectCountry } from '../lib/geo';
import { getCurrencyPricing } from '../lib/pricing';
import { formatMoney } from '../lib/money';

export const prerender = false;

const isAuthed = !!Astro.locals.user;
const userEmail = Astro.locals.user?.email ?? '';
const authRedirect = '/register?next=/order';
const orderCta = isAuthed ? '/order' : authRedirect;
const country = detectCountry(Astro.request, Astro.locals.runtime);
const { currency, pricing } = await getCurrencyPricing(Astro.locals.runtime?.env?.SIDDH_KV, country);
const kundliNow = formatMoney(pricing.kundliCents, currency);
const kundliWas = formatMoney(pricing.kundliWasCents, currency);
const f1 = formatMoney(pricing.followupTierCents[1], currency);
const f2 = formatMoney(pricing.followupTierCents[2], currency);
const f3 = formatMoney(pricing.followupTierCents[3], currency);

const faqItems = [
  {
    question: 'How accurate is the chart?',
    answer:
      'Every planetary position is computed with a professional astronomical ephemeris (sidereal zodiac, Lahiri ayanamsa, whole-sign houses) — accurate to the arc-second. Nothing is estimated or hard-coded.',
  },
  {
    question: 'What do I receive, and when?',
    answer:
      'A detailed multi-page PDF report emailed to you once your assigned pandit completes it, along with an encrypted reference number for future follow-up questions.',
  },
  {
    question: 'Do I need an account?',
    answer:
      'Yes. A free account is required to place an order, keeps your reports together, and lets you return for follow-up questions.',
  },
  {
    question: 'What is the money-back guarantee?',
    answer:
      "If you're not satisfied with your report, contact us and we'll refund you in full. We stand behind the quality of every reading.",
  },
  {
    question: 'Why is the time of birth so important?',
    answer:
      'Your ascendant (Lagna) changes roughly every two hours, reshaping the entire chart. An accurate time — including AM/PM — is essential.',
  },
  {
    question: 'Can I gift this to someone?',
    answer:
      "Absolutely. Enter your loved one's birth details and your own email. You'll receive the report so you can present it personally — a truly meaningful and personal gift.",
  },
];

const homeStructuredData = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'Service',
      name: 'Siddh Jyotish Janma Kundli Report',
      description:
        'A precise, hand-crafted Vedic Janma Kundli report with up to 3 included questions, prepared by respected astrologers.',
      url: 'https://siddhjyotish.com/order',
      provider: { '@id': 'https://siddhjyotish.com#organization' },
      areaServed: 'Worldwide',
      offers: {
        '@type': 'Offer',
        priceCurrency: currency.toUpperCase(),
        price: (pricing.kundliCents / 100).toFixed(2),
        availability: 'https://schema.org/InStock',
        url: 'https://siddhjyotish.com/order',
      },
    },
    {
      '@type': 'FAQPage',
      mainEntity: faqItems.map((item) => ({
        '@type': 'Question',
        name: item.question,
        acceptedAnswer: {
          '@type': 'Answer',
          text: item.answer,
        },
      })),
    },
  ],
};
---

<Base
  title="Vedic Janma Kundli Reports | Siddh Jyotish"
  description="Order a precise Vedic Janma Kundli report with 3 included questions, or return later to ask follow-up astrology questions from the same chart."
>
  <div class="wrap wrap-wide">
    <section class="hero hero-split">
      <div class="hero-media" aria-hidden="true">
        <img src="/hero-astrologer.png" alt="" />
      </div>
      <div class="hero-copy">
        <span class="eyebrow">Prepared by respected Vedic astrologers</span>
        <h1>Your Janma Kundli,<br class="hero-break" /> read by hand —<br class="hero-break" /> not by software.</h1>
        <p class="lead">
          A genuine Vedic birth chart, cast from your exact birth details and interpreted personally by a real pandit from 5000 year old lineage.
        </p>
        <div class="hero-cta">
          <a class="btn hero-primary-cta" href={orderCta}>Start my reading <Icon name="arrow-right" size={22} /></a>
        </div>
        <div class="hero-trust" aria-label="Service assurances">
          <span><Icon name="shield" size={18} />100% money-back</span>
          <span><Icon name="lock" size={18} />Private &amp; secure</span>
          <span><Icon name="clock" size={18} />Delivered in ~1 hour</span>
        </div>
        <p class="hero-followup">Already ordered? <a href="/returning">Ask a follow-up question</a></p>
      </div>
    </section>
  </div>

  <div class="wrap">
    <section class="block">
      <div class="badges">
        <div class="badge">
          <div class="ico"><Icon name="target" size={28} /></div>
          <b>100% Accurate</b>
          <span>Precisely calculated placements — never guessed or hard-coded.</span>
        </div>
        <div class="badge">
          <div class="ico"><Icon name="shield" size={28} /></div>
          <b>100% Money-Back Guarantee</b>
          <span>Not satisfied with your report? We refund you in full.</span>
        </div>
        <div class="badge">
          <div class="ico"><Icon name="om" size={28} /></div>
          <b>Respected Astrologers</b>
          <span>Prepared and personally reviewed by experienced Vedic pandits.</span>
        </div>
        <div class="badge">
          <div class="ico"><Icon name="lock" size={28} /></div>
          <b>Private &amp; Secure</b>
          <span>Your account keeps your reading history private and organized.</span>
        </div>
      </div>
    </section>
  </div>

  <div class="wrap">
    <section class="block social-proof-strip">
      <div class="proof-stats">
        <div class="stat"><b>2,400+</b><span>readings delivered</span></div>
        <div class="stat"><b>99%</b><span>satisfaction rate</span></div>
        <div class="stat"><b>1 hr</b><span>average delivery</span></div>
      </div>
    </section>
  </div>

  <div class="wrap">
    <section class="block" id="how">
      <div class="section-head">
        <h2>How it works</h2>
        <p>Three simple steps. Your private account keeps every reading organized.</p>
      </div>
      <div class="steps">
        <div class="step">
          <div class="num">1</div>
          <h3>Share your birth details</h3>
          <p>Name, gender, exact date, time (with AM/PM), place of birth and its timezone. That's all your chart needs.</p>
        </div>
        <div class="step">
          <div class="num">2</div>
          <h3>A pandit prepares your chart</h3>
          <p>Your assigned astrologer computes the chart and writes an original, personal reading.</p>
        </div>
        <div class="step">
          <div class="num">3</div>
          <h3>Receive your report by email</h3>
          <p>A detailed PDF plus a private reference number — used to ask follow-up questions later.</p>
        </div>
      </div>
    </section>
  </div>

  <div class="wrap">
    <section class="block" id="about">
      <div class="section-head">
        <h2>About Siddh Jyotish</h2>
        <p>A living lineage. Precision you can trust.</p>
      </div>
      <div class="about-story">
        <div class="about-content">
          <p class="about-lead">
            <em>"Siddh"</em> means accomplished, proven — and that is precisely
            what we offer: <strong>proven astrology from a living lineage of
            scholars</strong>, not generic predictions from an algorithm.
          </p>
          <p>
            Our astrologers are <strong>Siddh Yogis</strong> who carry forward a
            centuries-old dual tradition — descended from a
            <strong>Kashmiri Pandit</strong> lineage and a
            <strong>Kerala Namboodiri Brahmin</strong> lineage of Jyotish
            scholars. These families have practised and refined Vedic astrology
            for generations, passing the knowledge of planetary computation, dasha
            interpretation, and remedial precision from guru to student without
            interruption.
          </p>
          <p>
            Every chart we produce is computed using a
            <strong>professional astronomical ephemeris</strong> (sidereal zodiac, Lahiri ayanamsa,
            whole-sign houses) — accurate to the arc-second. Nothing is estimated,
            approximated, or hard-coded. We pair computational precision with
            interpretive depth that only comes from lifetime immersion in
            <em>shastras</em>.
          </p>
          <p>
            We believe astrology should be an <strong>honest guide</strong> — not
            a fear-based upsell machine. You will never hear us say "pay more or
            face doom." Instead, you receive a candid, carefully-worded report
            that respects your intelligence and helps you make decisions with
            clarity.
          </p>
          <p class="about-promise">
            This is not a $5 horoscope app. This is a genuine consultation with a
            respected pandit — and we stand behind every reading with a
            <strong>100% money-back guarantee</strong>.
          </p>
        </div>
      </div>
    </section>
  </div>

  <div class="wrap">
    <section class="block">
      <div class="section-head">
        <h2>Trusted by seekers worldwide</h2>
      </div>
      <div class="testimonials">
        <div class="quote">
          <div class="stars">★★★★★</div>
          <p>"The timing predictions were uncannily accurate. The report read like it was written just for me."</p>
          <div class="who">— Priya M., Toronto</div>
        </div>
        <div class="quote">
          <div class="stars">★★★★★</div>
          <p>"Detailed, precise and beautifully explained. Worth every rupee — and the follow-up answers were superb."</p>
          <div class="who">— Arjun R., London</div>
        </div>
        <div class="quote">
          <div class="stars">★★★★★</div>
          <p>"I finally understood my dasha periods. The remedies were practical and specific to my chart."</p>
          <div class="who">— Neha S., Bengaluru</div>
        </div>
        <div class="quote">
          <div class="stars">★★★★★</div>
          <p>"My mother was moved to tears. It was the most personal gift I could give her."</p>
          <div class="who">— Anita K., New Jersey</div>
        </div>
      </div>
    </section>
  </div>

  <div class="wrap">
    <section class="block" id="faq">
      <div class="section-head">
        <h2>Frequently asked questions</h2>
      </div>
      <div class="faq">
        {faqItems.map((item, index) => (
          <details open={index === 0}>
            <summary>{item.question}</summary>
            <p>{item.answer}</p>
          </details>
        ))}
      </div>
      <p class="center" style="margin-top:1.5rem">
        Already have a reference number?
        <a href="/returning">Ask follow-up questions →</a>
      </p>
    </section>
  </div>

  <script type="application/ld+json" set:html={JSON.stringify(homeStructuredData)}></script>

  <div class="wrap">
    <section class="block final-cta-section">
      <div class="final-cta-box">
        <h2>Your chart is waiting to be read.</h2>
        <p>
          Whether you're seeking career clarity, timing a life decision, or
          gifting insight to a loved one — a precise Janma Kundli from Siddh
          Jyotish gives you the guide you deserve.
        </p>
        <div class="final-cta-actions">
          <a class="btn" href={orderCta}>Get my Kundli — {kundliNow}</a>
          <a class="btn btn-ghost-dark" href="/returning">I have a reference — ask questions</a>
        </div>
        <p class="final-cta-reassure">100% money-back guarantee · Private account · Delivered by email</p>
      </div>
    </section>
  </div>
</Base>

<style>
  /* Hero split */
  .hero-split {
    width: 100%;
    min-height: 650px;
    margin-top: 2rem;
    padding: 0;
    display: grid;
    grid-template-columns: minmax(0, 1.08fr) minmax(0, 0.92fr);
    align-items: stretch;
    overflow: hidden;
    border-radius: 28px;
    background: linear-gradient(130deg, #21194c 0%, #302064 48%, #4b2684 100%);
    box-shadow: 0 22px 55px rgba(34, 26, 78, 0.2);
  }
  .wrap-wide {
    max-width: 1240px;
  }
  .hero-copy { position: relative; z-index: 1; }
  .hero-media {
    display: block;
    order: 2;
    min-width: 0;
    overflow: hidden;
    position: relative;
  }
  .hero-media::after {
    content: '';
    position: absolute;
    inset: 0;
    background: linear-gradient(90deg, rgba(34, 26, 78, 0.22), transparent 35%);
    pointer-events: none;
  }
  .hero-media img {
    width: 100%;
    height: 100%;
    display: block;
    object-fit: cover;
    object-position: 90% center;
  }
  .hero .lead { color: #c8c3e3; font-size: 1rem; line-height: 1.65; max-width: 42ch; }
  .eyebrow {
    display: inline-block; font-family: var(--sans); font-weight: 600;
    letter-spacing: 2px; text-transform: uppercase; font-size: 0.8rem;
    color: #37d0c6; margin-bottom: 1.35rem; position: relative;
  }
  .hero .eyebrow::after {
    content: ''; display: block; width: 42px; height: 2px; margin-top: 0.65rem;
    background: #37d0c6; border-radius: 2px;
  }

  /* Social proof strip */
  .social-proof-strip { padding: 1.5rem 0 !important; }
  .proof-stats {
    display: flex;
    justify-content: center;
    gap: 3rem;
    flex-wrap: wrap;
  }
  .stat { text-align: center; }
  .stat b {
    display: block;
    font-family: var(--serif);
    font-size: 1.6rem;
    color: var(--maroon);
  }
  .stat span { color: var(--muted); font-size: 0.9rem; }

  /* About section */
  .about-story {
    max-width: 700px;
    margin: 0 auto;
  }
  .about-content p {
    font-size: 1.05rem;
    line-height: 1.75;
    color: var(--text);
  }
  .about-lead {
    font-family: var(--serif-2);
    font-size: 1.25rem !important;
    color: var(--maroon) !important;
    border-left: 3px solid var(--gold);
    padding-left: 1rem;
    margin-bottom: 1.5rem !important;
  }
  .about-promise {
    background: linear-gradient(135deg, #fff7e6, #fef5dd);
    border: 1px solid var(--border);
    border-radius: 12px;
    padding: 1rem 1.2rem;
    margin-top: 1.5rem !important;
  }

  /* Final CTA section */
  .final-cta-section { padding-bottom: 1rem !important; }
  .final-cta-box {
    text-align: center;
    background:
      radial-gradient(600px 250px at 50% 0, rgba(243,168,56,0.15), transparent),
      linear-gradient(160deg, var(--indigo) 0%, var(--indigo-2) 55%, #3a2a72 100%);
    color: #f0e6ff;
    border-radius: 22px;
    padding: clamp(2rem, 5vw, 3.5rem) clamp(1.4rem, 4vw, 3rem);
  }
  .final-cta-box h2 { color: #fff; }
  .final-cta-box p { color: #d9ccff; max-width: 52ch; margin: 0 auto 1.2rem; }
  .final-cta-actions {
    display: flex;
    justify-content: center;
    gap: 0.8rem;
    flex-wrap: wrap;
    margin: 1.5rem 0 1rem;
  }
  .btn-ghost-dark {
    background: transparent;
    color: #fff;
    border: 1.5px solid rgba(255,255,255,0.4);
    box-shadow: none;
  }
  .btn-ghost-dark:hover { background: rgba(255,255,255,0.1); text-decoration: none; }
  .final-cta-reassure { font-size: 0.88rem; color: #a99fd6 !important; margin-top: 0.5rem !important; }
  .hero-split .hero-copy {
    order: 1;
    min-width: 0;
    align-self: center;
    padding: 3.8rem 3.6rem;
  }
  .hero-split h1 { font-size: clamp(2.6rem, 4vw, 3.5rem); max-width: none; line-height: 1.02; }
  .hero-primary-cta {
    width: 100%;
    min-height: 72px;
    justify-content: center;
    gap: 4rem;
    padding: 0 1.5rem 0 2rem;
    border-radius: 16px;
    background: linear-gradient(105deg, #f5c15c, #f2695c);
    color: #241a4d;
    font-family: var(--serif);
    font-size: 1.62rem;
  }
  .hero-trust {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 0;
    margin-top: 1.35rem;
    border: 1px solid rgba(177, 169, 221, 0.32);
    border-radius: 12px;
    overflow: hidden;
  }
  .hero-trust span { display: flex; align-items: center; gap: 0.4rem; }
  .hero-trust span {
    min-width: 0;
    padding: 0.7rem 0.65rem;
    color: #fff;
    font-size: 0.7rem;
    line-height: 1.25;
  }
  .hero-trust span + span { border-left: 1px solid rgba(255, 255, 255, 0.15); }
  .hero-trust svg { flex: 0 0 auto; color: #37d0c6; }
  .hero-followup { color: #aaa5ca; font-size: 0.78rem; margin-top: 1.15rem; }
  .hero-followup a { color: #37d0c6; font-weight: 600; text-decoration: underline; text-underline-offset: 3px; }
  @media (max-width: 820px) {
    .hero-split {
      display: block;
      min-height: 0;
      margin-top: 0.9rem;
      border-radius: 22px;
      background: linear-gradient(160deg, #21194c 0%, #43227e 100%);
    }
    .hero-media { height: 275px; }
    .hero-media img {
      width: 100%;
      height: 160%;
      object-position: 100% 30%;
    }
    .hero-media::after { background: linear-gradient(0deg, rgba(34, 26, 78, 0.2), transparent 45%); }
    .hero-split .hero-copy { padding: 2.3rem 1.25rem 2.5rem; text-align: center; }
    .hero-split h1 {
      max-width: none;
      margin-left: auto;
      margin-right: auto;
      font-size: clamp(1.95rem, 8vw, 2rem);
      letter-spacing: -0.03em;
    }
    .hero .lead { max-width: 34ch; margin-left: auto; margin-right: auto; }
    .hero .eyebrow::after { margin-left: auto; margin-right: auto; }
    .hero .eyebrow {
      display: block;
      text-align: center;
      white-space: nowrap;
      font-size: 0.62rem;
      letter-spacing: 1px;
    }
    .hero-primary-cta {
      width: 100%;
      min-height: 62px;
      padding-left: 1.25rem;
      padding-right: 1.1rem;
      gap: 2rem;
      font-size: 1.3rem;
      text-align: left;
    }
    .hero-trust { display: block; text-align: left; }
    .hero-trust span { min-height: 48px; padding: 0.7rem 0.9rem; font-size: 0.78rem; }
    .hero-trust span + span { border-left: 0; border-top: 1px solid rgba(255, 255, 255, 0.15); }
    .hero-followup { text-align: center; }
  }
</style>
