---
import Base from '../layouts/Base.astro';
import TimezoneOptions from '../components/TimezoneOptions.astro';
import { env } from '../lib/env';

export const prerender = false;
if (!Astro.locals.user) return Astro.redirect('/login?next=/chat');

const packs = env.chat.packs.map((p) => ({ ...p, label: `$${(p.cents / 100).toFixed(p.cents % 100 ? 2 : 0)}` }));
---

<Base title="Ask Pandit ji | Siddh Jyotish" description="Live Vedic astrology consultation from your own birth chart." noindex>
  <div class="wrap">
    <section class="chat-shell">
      <aside class="chat-side">
        <div class="credits-card">
          <span class="eyebrow">Your questions</span>
          <p class="credits"><strong id="credits">–</strong> remaining</p>
          <div class="packs">
            {packs.map((p) => (
              <button class="btn btn-small btn-outline buy-pack" type="button" data-pack={p.id}>
                {p.credits} questions · {p.label}
              </button>
            ))}
          </div>
          <p class="helper">Every Kundli report includes {env.chat.creditsPerKundli} chat questions.</p>
        </div>
        <h2 class="side-title">Consultations</h2>
        <ul id="thread-list" class="thread-list"></ul>
        <button id="new-thread" class="btn btn-small" type="button">+ New birth profile</button>
      </aside>

      <div class="chat-main">
        <div id="banner" class="banner" hidden></div>

        <form id="profile-form" class="profile-form" hidden>
          <h1>Whose chart should Pandit ji read?</h1>
          <p class="helper">Save a birth profile once — yourself, spouse, child or parent — and ask about past and future anytime. Starting a consultation (the opening reading) uses 1 question.</p>
          <div class="grid">
            <label>Full name<input name="fullName" required maxlength="120" /></label>
            <label>Gender
              <select name="gender" required>
                <option value="" disabled selected>Select…</option>
                <option>Male</option><option>Female</option><option>Other</option>
              </select>
            </label>
            <label>Date of birth<input type="date" name="dateOfBirth" min="1900-01-01" required /></label>
            <label>Time of birth<input type="time" name="timeOfBirth" required /></label>
            <label class="span2">Place of birth<input name="placeOfBirth" placeholder="City, State, Country" required maxlength="160" /></label>
            <label class="span2">Timezone of birthplace
              <select name="timezone" required>
                <option value="" disabled selected>Select the timezone of the birthplace…</option>
                <TimezoneOptions />
              </select>
            </label>
          </div>
          <p class="field-error" id="profile-error" aria-live="polite"></p>
          <div class="form-actions">
            <button class="btn" type="submit" id="profile-submit">Start consultation</button>
            <button class="btn btn-outline" type="button" id="profile-cancel">Cancel</button>
          </div>
        </form>

        <div id="conversation" class="conversation" hidden>
          <header class="conv-head">
            <div>
              <h1 id="conv-title"></h1>
              <p id="conv-sub" class="helper"></p>
            </div>
          </header>
          <div id="messages" class="messages" aria-live="polite"></div>
          <div id="typing" class="typing" hidden>Pandit ji is studying your chart<span>.</span><span>.</span><span>.</span></div>
          <form id="ask-form" class="ask-form">
            <textarea id="ask-input" rows="2" maxlength={env.chat.maxMessageChars} placeholder="Ask about career, marriage, health, finances, a past event… (1 question)"></textarea>
            <button class="btn" type="submit" id="ask-submit">Ask</button>
          </form>
          <p class="field-error" id="ask-error" aria-live="polite"></p>
          <div class="suggestions" id="suggestions">
            <button type="button" class="chip">When will my career grow?</button>
            <button type="button" class="chip">When is a good time for marriage?</button>
            <button type="button" class="chip">Why was last year so hard for me?</button>
            <button type="button" class="chip">What should I focus on in the next 12 months?</button>
          </div>
          <p class="disclaimer">Astrological guidance for reflection only — not a substitute for medical, legal or financial advice.</p>
        </div>
      </div>
    </section>
  </div>
</Base>

<script>
  import { renderMarkdown } from '../lib/markdown';

  type Thread = { id: string; fullName: string; dateOfBirth: string; timeOfBirth: string; placeOfBirth: string; pandit: string; status: string };
  type Msg = { id: string; role: 'user' | 'pandit'; body: string; createdAt: string };

  const $ = <T extends HTMLElement>(id: string) => document.getElementById(id) as T;
  const creditsEl = $('credits');
  const threadList = $<HTMLUListElement>('thread-list');
  const profileForm = $<HTMLFormElement>('profile-form');
  const conversation = $('conversation');
  const messagesEl = $('messages');
  const typing = $('typing');
  const askForm = $<HTMLFormElement>('ask-form');
  const askInput = $<HTMLTextAreaElement>('ask-input');
  const askSubmit = $<HTMLButtonElement>('ask-submit');
  const askError = $('ask-error');
  const banner = $('banner');

  let threads: Thread[] = [];
  let current: Thread | null = null;
  let credits = 0;
  let pollTimer: number | undefined;
  let rendered = '';

  function showBanner(html: string): void {
    banner.innerHTML = html;
    banner.hidden = false;
  }

  function setCredits(n: number): void {
    credits = n;
    creditsEl.textContent = String(n);
  }

  function noCreditsBanner(): void {
    showBanner('You have no questions left. Buy a question pack on the left, or <a href="/#order">order a full Kundli report</a> (includes chat questions).');
  }

  async function api<T>(url: string, init?: RequestInit): Promise<{ ok: boolean; status: number; data: T & { error?: string; credits?: number } }> {
    const res = await fetch(url, { ...init, headers: { 'Content-Type': 'application/json' } });
    const data = await res.json().catch(() => ({}));
    if (typeof data.credits === 'number') setCredits(data.credits);
    return { ok: res.ok, status: res.status, data };
  }

  function renderThreads(): void {
    threadList.innerHTML = '';
    for (const t of threads) {
      const li = document.createElement('li');
      const b = document.createElement('button');
      b.type = 'button';
      b.className = 'thread' + (current?.id === t.id ? ' active' : '');
      b.textContent = t.fullName;
      const small = document.createElement('small');
      small.textContent = `${t.dateOfBirth} · ${t.placeOfBirth}`;
      b.append(small);
      b.addEventListener('click', () => openThread(t));
      li.append(b);
      threadList.append(li);
    }
  }

  function showProfileForm(): void {
    stopPolling();
    current = null;
    renderThreads();
    conversation.hidden = true;
    profileForm.hidden = false;
    $('profile-cancel').hidden = threads.length === 0;
    if (credits < 1) noCreditsBanner();
  }

  function openThread(t: Thread): void {
    current = t;
    rendered = '';
    renderThreads();
    profileForm.hidden = true;
    conversation.hidden = false;
    banner.hidden = true;
    $('conv-title').textContent = `${t.fullName}'s consultation`;
    $('conv-sub').textContent = `with ${t.pandit} · born ${t.dateOfBirth} ${t.timeOfBirth}, ${t.placeOfBirth}`;
    messagesEl.innerHTML = '';
    history.replaceState(null, '', `/chat?t=${encodeURIComponent(t.id)}`);
    poll();
  }

  function stopPolling(): void {
    if (pollTimer) window.clearTimeout(pollTimer);
    pollTimer = undefined;
  }

  function renderMessages(msgs: Msg[]): void {
    const key = msgs.map((m) => m.id).join(',');
    if (key === rendered) return;
    rendered = key;
    messagesEl.innerHTML = '';
    for (const m of msgs) {
      const div = document.createElement('div');
      div.className = `msg ${m.role}`;
      if (m.role === 'pandit') div.innerHTML = renderMarkdown(m.body);
      else div.textContent = m.body;
      messagesEl.append(div);
    }
    messagesEl.scrollTop = messagesEl.scrollHeight;
    $('suggestions').hidden = msgs.some((m) => m.role === 'user');
  }

  async function poll(): Promise<void> {
    stopPolling();
    if (!current) return;
    const id = current.id;
    const { ok, data } = await api<{ messages: Msg[]; pending: number; thread: Thread }>(`/api/chat/messages?threadId=${encodeURIComponent(id)}`);
    if (!current || current.id !== id) return;
    if (ok) {
      renderMessages(data.messages);
      typing.hidden = data.pending === 0;
      if (data.thread.status === 'failed') showBanner('This consultation could not be started. Please create it again — your question was refunded.');
    }
    const delay = ok && data.pending > 0 ? 4000 : 20000;
    pollTimer = window.setTimeout(poll, document.hidden ? Math.max(delay, 15000) : delay);
  }

  profileForm.addEventListener('submit', async (e) => {
    e.preventDefault();
    const err = $('profile-error');
    err.textContent = '';
    const submit = $<HTMLButtonElement>('profile-submit');
    submit.disabled = true;
    submit.textContent = 'Casting the chart…';
    const body = Object.fromEntries(new FormData(profileForm).entries());
    const { ok, status, data } = await api<{ thread: Thread }>('/api/chat/threads', { method: 'POST', body: JSON.stringify(body) });
    submit.disabled = false;
    submit.textContent = 'Start consultation';
    if (status === 402) return noCreditsBanner();
    if (!ok) {
      err.textContent = data.error ?? 'Something went wrong.';
      return;
    }
    profileForm.reset();
    threads.unshift(data.thread);
    openThread(data.thread);
  });

  $('profile-cancel').addEventListener('click', () => threads[0] && openThread(threads[0]));
  $('new-thread').addEventListener('click', showProfileForm);

  async function ask(text: string): Promise<void> {
    if (!current || !text.trim()) return;
    askError.textContent = '';
    if (credits < 1) return noCreditsBanner();
    askSubmit.disabled = true;
    const { ok, status, data } = await api<{ message: Msg }>('/api/chat/messages', {
      method: 'POST',
      body: JSON.stringify({ threadId: current.id, text }),
    });
    askSubmit.disabled = false;
    if (status === 402) return noCreditsBanner();
    if (!ok) {
      askError.textContent = data.error ?? 'Something went wrong.';
      return;
    }
    askInput.value = '';
    typing.hidden = false;
    rendered = '';
    poll();
  }

  askForm.addEventListener('submit', (e) => {
    e.preventDefault();
    ask(askInput.value);
  });
  askInput.addEventListener('keydown', (e) => {
    if (e.key === 'Enter' && !e.shiftKey) {
      e.preventDefault();
      ask(askInput.value);
    }
  });
  document.querySelectorAll<HTMLButtonElement>('.chip').forEach((chip) =>
    chip.addEventListener('click', () => ask(chip.textContent ?? '')),
  );

  document.querySelectorAll<HTMLButtonElement>('.buy-pack').forEach((btn) =>
    btn.addEventListener('click', async () => {
      btn.disabled = true;
      const { ok, data } = await api<{ url: string }>('/api/checkout/chat', {
        method: 'POST',
        body: JSON.stringify({ packId: btn.dataset.pack }),
      });
      btn.disabled = false;
      if (ok && data.url) window.location.href = data.url;
      else showBanner('Checkout is unavailable right now. Please try again.');
    }),
  );

  document.addEventListener('visibilitychange', () => {
    if (!document.hidden && current) poll();
  });

  (async () => {
    const params = new URLSearchParams(location.search);
    const { data } = await api<{ threads: Thread[] }>('/api/chat/threads');
    threads = data.threads ?? [];
    if (params.get('purchased')) showBanner('Thank you! Your questions will appear in your balance within a few seconds.');
    const wanted = threads.find((t) => t.id === params.get('t')) ?? threads[0];
    if (wanted) openThread(wanted);
    else showProfileForm();
    if (params.get('purchased')) window.setTimeout(() => api('/api/chat/threads'), 4000);
  })();
</script>

<style>
  .chat-shell {
    display: grid; grid-template-columns: 280px 1fr; gap: 1.5rem;
    padding: clamp(1.5rem, 5vw, 3rem) 0; align-items: start;
  }
  .chat-side { display: flex; flex-direction: column; gap: 0.9rem; position: sticky; top: 1rem; }
  .credits-card, .profile-form, .conversation {
    background: var(--card); border: 1px solid var(--border); border-radius: 20px;
    padding: clamp(1rem, 3vw, 1.5rem); box-shadow: 0 16px 44px rgba(122,30,30,0.09);
  }
  .credits { font-size: 1.1rem; margin: 0.4rem 0 0.8rem; }
  .credits strong { font-size: 1.8rem; color: var(--maroon); }
  .packs { display: flex; flex-direction: column; gap: 0.5rem; }
  .helper { color: var(--muted); font-size: 0.9rem; }
  .side-title { font-size: 1rem; margin: 0.5rem 0 0; }
  .thread-list { list-style: none; padding: 0; margin: 0; display: flex; flex-direction: column; gap: 0.4rem; }
  .thread {
    width: 100%; text-align: left; background: var(--card); border: 1px solid var(--border);
    border-radius: 12px; padding: 0.6rem 0.8rem; cursor: pointer; font: inherit; color: var(--text);
  }
  .thread small { display: block; color: var(--muted); font-size: 0.78rem; }
  .thread.active { border-color: var(--saffron); box-shadow: 0 0 0 2px rgba(242,105,92,0.15); }
  .banner { background: #fff7e6; border: 1px solid var(--marigold); border-radius: 12px; padding: 0.8rem 1rem; margin-bottom: 1rem; }
  .profile-form h1, .conv-head h1 { font-size: clamp(1.3rem, 3vw, 1.7rem); margin: 0 0 0.3rem; }
  .grid { display: grid; grid-template-columns: 1fr 1fr; gap: 0.8rem; margin-top: 1rem; }
  .grid label { display: flex; flex-direction: column; gap: 0.3rem; font-weight: 600; font-size: 0.9rem; }
  .grid .span2 { grid-column: span 2; }
  .grid input, .grid select, .ask-form textarea {
    font: inherit; padding: 0.6rem 0.7rem; border: 1px solid var(--border); border-radius: 10px; background: #fff;
  }
  .form-actions { display: flex; gap: 0.6rem; margin-top: 1rem; }
  .field-error { color: var(--error); min-height: 1.2em; margin: 0.4rem 0 0; }
  .conv-head { border-bottom: 1px solid var(--border); padding-bottom: 0.6rem; }
  .conv-head p { margin: 0; }
  .messages { display: flex; flex-direction: column; gap: 0.9rem; max-height: 62vh; overflow-y: auto; padding: 1rem 0.2rem; }
  .msg { padding: 0.8rem 1rem; border-radius: 16px; line-height: 1.55; max-width: 92%; overflow-wrap: anywhere; }
  .msg.user { align-self: flex-end; background: var(--indigo); color: #fff; white-space: pre-wrap; border-bottom-right-radius: 4px; }
  .msg.pandit { align-self: flex-start; background: var(--cream); border: 1px solid var(--border); border-bottom-left-radius: 4px; }
  .msg.pandit :global(h3), .msg.pandit :global(h4), .msg.pandit :global(h5) { margin: 0.8rem 0 0.3rem; font-size: 1.02rem; }
  .msg.pandit :global(p) { margin: 0.4rem 0; }
  .msg.pandit :global(ul), .msg.pandit :global(ol) { margin: 0.3rem 0; padding-left: 1.3rem; }
  .msg.pandit :global(.md-table) { overflow-x: auto; }
  .msg.pandit :global(table) { border-collapse: collapse; font-size: 0.88rem; margin: 0.5rem 0; }
  .msg.pandit :global(th), .msg.pandit :global(td) { border: 1px solid var(--border); padding: 0.3rem 0.5rem; text-align: left; }
  .typing { color: var(--muted); font-style: italic; padding: 0.3rem 0; }
  .typing span { animation: blink 1.4s infinite; }
  .typing span:nth-child(2) { animation-delay: 0.2s; }
  .typing span:nth-child(3) { animation-delay: 0.4s; }
  @keyframes blink { 0%, 80%, 100% { opacity: 0; } 40% { opacity: 1; } }
  .ask-form { display: flex; gap: 0.6rem; align-items: flex-end; border-top: 1px solid var(--border); padding-top: 0.8rem; }
  .ask-form textarea { flex: 1; resize: vertical; min-height: 3rem; }
  .suggestions { display: flex; flex-wrap: wrap; gap: 0.4rem; }
  .chip { font: inherit; font-size: 0.85rem; border: 1px solid var(--border); background: #fff; border-radius: 999px; padding: 0.35rem 0.8rem; cursor: pointer; }
  .chip:hover { border-color: var(--saffron); }
  .disclaimer { color: var(--muted); font-size: 0.78rem; margin: 0.8rem 0 0; }
  @media (max-width: 820px) {
    .chat-shell { grid-template-columns: 1fr; }
    .chat-side { position: static; }
    .grid { grid-template-columns: 1fr; }
    .grid .span2 { grid-column: auto; }
  }
</style>
