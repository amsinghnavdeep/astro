---
type BaseIconName =
  | 'target'
  | 'shield'
  | 'om'
  | 'lotus'
  | 'lock'
  | 'clock'
  | 'mail'
  | 'sparkle'
  | 'check'
  | 'user'
  | 'menu'
  | 'x'
  | 'arrow-right'
  | 'star'
  | 'history'
  | 'compass';
type IconName =
  | BaseIconName
  | 'accuracy'
  | 'money-back'
  | 'astrologers'
  | 'private'
  | 'delivery'
  | 'email';

interface Props {
  name: IconName;
  size?: number;
  label?: string;
  class?: string;
}

const { name, size = 24, label, class: className = '' } = Astro.props;
const basePaths: Record<BaseIconName, string[]> = {
