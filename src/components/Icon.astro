    'm9 12 2 2 4-4',
  ],
  om: [
    'M6 8c0-1.7 1.3-3 3-3 2 0 3.4 1.2 3.4 3 0 1.7-1.4 2.8-3.4 2.8H7.8c-1.7 0-2.8 1-2.8 2.6 0 2.1 1.8 3.6 4.5 3.6 3.5 0 5.6-2 5.6-5.1V5',
    'M18.5 5h.01',
    'M18 18.5h.01',
  ],
  lotus: [
    'M12 20c-4.6 0-8-2.3-8-5.5 2.4-.1 4.4.6 5.8 2-1.7-2.7-1.6-5.4-.5-7.5 2.1 1.2 3 3.3 2.7 6.2.3-2.9 1.2-5 3.3-6.2 1.1 2.1 1.2 4.8-.5 7.5 1.4-1.4 3.4-2.1 5.8-2C20 17.7 16.6 20 12 20Z',
    'M4 14.5c2.9 0 5.5 1.8 8 5.5 2.5-3.7 5.1-5.5 8-5.5',
