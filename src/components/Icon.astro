const paths: Record<IconName, string[]> = {
  ...basePaths,
  accuracy: basePaths.target,
  'money-back': basePaths.shield,
  astrologers: basePaths.user,
  private: basePaths.lock,
  delivery: basePaths.clock,
  email: basePaths.mail,
};
---

<svg
  class={className}
  width={size}
  height={size}
  viewBox="0 0 24 24"
  fill="none"
  stroke="currentColor"
  stroke-width="2"
  stroke-linecap="round"
  stroke-linejoin="round"
  aria-hidden={label ? undefined : 'true'}
  aria-label={label}
  focusable="false"
>
  {paths[name].map((d) => <path d={d} />)}
</svg>
