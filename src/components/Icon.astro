---
type BaseIconName = 'target' | 'shield' | 'om' | 'lock' | 'clock' | 'mail' | 'sparkle' | 'check';
type IconName = BaseIconName | 'accuracy' | 'money-back' | 'lotus' | 'astrologers' | 'private' | 'delivery' | 'email';

interface Props {
  name: IconName;
  size?: number;
  label?: string;
  class?: string;
}

const { name, size = 24, label, class: className = '' } = Astro.props;
const basePaths: Record<BaseIconName, string[]> = {
  target: [
    'M12 3a9 9 0 1 0 9 9',
    'M12 7a5 5 0 1 0 5 5',
    'M12 12l6-6',
    'M18 3v3h3',
  ],
  shield: [
    'M12 3l7 3v5c0 4.5-3 7.6-7 10-4-2.4-7-5.5-7-10V6l7-3z',
    'M9 12l2 2 4-4',
  ],
  om: [
    'M8.5 7.5c-1.8 0-3 1.2-3 2.8 0 1.7 1.3 2.7 3.2 2.7h3.1c2.3 0 3.7 1.2 3.7 3.1 0 2-1.7 3.4-4 3.4-2.8 0-4.5-1.7-4.5-4.3',
    'M11.8 6.8c2.4 0 4.2 1.4 4.2 3.6 0 2.6-2.1 4.2-5.4 4.2',
    'M17.5 5.5v13',
    'M20 5.5h.01',
  ],
  lock: [
    'M6 10h12v10H6z',
    'M8.5 10V7a3.5 3.5 0 0 1 7 0v3',
    'M12 14v2',
  ],
  clock: [
    'M12 21a9 9 0 1 0 0-18 9 9 0 0 0 0 18z',
    'M12 7v5l3 2',
  ],
  mail: [
    'M3.5 5.5h17v13h-17z',
    'M4 7l8 6 8-6',
  ],
  sparkle: [
    'M12 2l1.3 6.7L20 10l-6.7 1.3L12 18l-1.3-6.7L4 10l6.7-1.3L12 2z',
    'M19 16l.5 2.5L22 19l-2.5.5L19 22l-.5-2.5L16 19l2.5-.5L19 16z',
  ],
  check: [
    'M12 21a9 9 0 1 0 0-18 9 9 0 0 0 0 18z',
    'M8 12l2.5 2.5L16 9',
  ],
};
const paths: Record<IconName, string[]> = {
  ...basePaths,
  accuracy: basePaths.target,
  'money-back': basePaths.shield,
  lotus: basePaths.om,
  astrologers: basePaths.om,
  private: basePaths.lock,
  delivery: basePaths.clock,
  email: basePaths.mail,
};
---

<svg
  class={className}
  width={size}
  height={size}
  viewBox="0 0 24 24"
  fill="none"
  stroke="currentColor"
  stroke-width="1.6"
  stroke-linecap="round"
  stroke-linejoin="round"
  aria-hidden={label ? undefined : 'true'}
  aria-label={label}
  focusable="false"
>
  {paths[name].map((d) => <path d={d} />)}
</svg>
