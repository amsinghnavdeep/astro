---
interface Props {
  title?: string;
}

const { title = 'Kundli — Vedic Astrology Reports' } = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content="Precise Vedic Janma Kundli reports. No account needed. Your reading is private." />
    <title>{title}</title>
  </head>
  <body>
    <main class="container">
      <slot />
    </main>
    <footer class="site-footer">
      <p>No account needed · Your reading is private</p>
    </footer>

    <style is:global>
      :root {
        --accent: #b8860b;
        --accent-dark: #8a640a;
        --bg: #faf5e6;
        --card: #fffdf7;
        --text: #2b2116;
        --muted: #6b5d47;
        --border: #e5d9bd;
        --error: #a12020;
      }

      * {
        box-sizing: border-box;
      }

      html,
      body {
        margin: 0;
        padding: 0;
      }

      body {
        background: var(--bg);
        color: var(--text);
        font-family: 'Segoe UI', Georgia, 'Times New Roman', serif;
        line-height: 1.6;
        min-height: 100vh;
        display: flex;
        flex-direction: column;
      }

      .container {
        flex: 1 0 auto;
        width: 100%;
        max-width: 640px;
        margin: 0 auto;
        padding: 2.5rem 1.25rem 3rem;
      }

      h1 {
        color: var(--accent-dark);
        font-size: clamp(1.7rem, 5vw, 2.4rem);
        line-height: 1.2;
        margin: 0 0 0.5rem;
      }

      h2 {
        color: var(--accent-dark);
        font-size: 1.3rem;
        margin: 0 0 0.75rem;
      }

      a {
        color: var(--accent-dark);
        text-decoration: underline;
      }

      p {
        margin: 0 0 1rem;
      }

      .lead {
        color: var(--muted);
        font-size: 1.1rem;
      }

      form {
        background: var(--card);
        border: 1px solid var(--border);
        border-radius: 12px;
        padding: 1.5rem;
        margin: 1.5rem 0;
        box-shadow: 0 2px 10px rgba(184, 134, 11, 0.08);
      }

      label {
        display: block;
        font-weight: 600;
        margin: 1rem 0 0.35rem;
      }

      label:first-of-type {
        margin-top: 0;
      }

      input,
      textarea {
        width: 100%;
        padding: 0.7rem 0.8rem;
        font-size: 1rem;
        font-family: inherit;
        color: var(--text);
        background: #fff;
        border: 1px solid var(--border);
        border-radius: 8px;
      }

      input:focus,
      textarea:focus {
        outline: none;
        border-color: var(--accent);
        box-shadow: 0 0 0 3px rgba(184, 134, 11, 0.18);
      }

      textarea {
        min-height: 5rem;
        resize: vertical;
      }

      .helper {
        color: var(--muted);
        font-size: 0.88rem;
        margin: 0.3rem 0 0;
      }

      button {
        margin-top: 1.5rem;
        width: 100%;
        padding: 0.85rem 1rem;
        font-size: 1.05rem;
        font-weight: 700;
        color: #fff;
        background: var(--accent);
        border: none;
        border-radius: 8px;
        cursor: pointer;
        transition: background 0.15s ease;
      }

      button:hover:not(:disabled) {
        background: var(--accent-dark);
      }

      button:disabled {
        opacity: 0.6;
        cursor: not-allowed;
      }

      .error {
        color: var(--error);
        background: #fbeaea;
        border: 1px solid #e6bcbc;
        border-radius: 8px;
        padding: 0.75rem 0.9rem;
        margin-top: 1rem;
      }

      .site-footer {
        flex-shrink: 0;
        text-align: center;
        color: var(--muted);
        font-size: 0.9rem;
        padding: 1.5rem 1rem 2rem;
        border-top: 1px solid var(--border);
      }

      .site-footer p {
        margin: 0;
      }
    </style>
  </body>
</html>
