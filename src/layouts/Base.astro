---
import Icon from '../components/Icon.astro';

interface Props {
  title?: string;
  description?: string;
  image?: string;
  noindex?: boolean;
}

const {
  title = 'Siddh Jyotish — Your Vedic Birth Chart, Created with Precision',
  description = 'Precise, hand-crafted Vedic Janma Kundli reports from Siddh Jyotish, prepared by respected astrologers. 100% accurate. 100% money-back guarantee.',
  image = '/zodiac-wheel.png',
  noindex = false,
} = Astro.props;

const siteOrigin = 'https://siddhjyotish.com';
const canonical = new URL(Astro.url.pathname, siteOrigin).toString();
const ogImage = new URL(image, siteOrigin).toString();
const robots = noindex ? 'noindex,nofollow' : 'index,follow';
const siteStructuredData = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'Organization',
      '@id': `${siteOrigin}#organization`,
      name: 'Siddh Jyotish',
      url: siteOrigin,
      logo: new URL('/logo-mark.svg', siteOrigin).toString(),
    },
    {
      '@type': 'WebSite',
      '@id': `${siteOrigin}#website`,
      name: 'Siddh Jyotish',
      url: siteOrigin,
      description,
      publisher: { '@id': `${siteOrigin}#organization` },
    },
  ],
};
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="robots" content={robots} />
    <meta name="theme-color" content="#7a1e1e" />
    <link rel="canonical" href={canonical} />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Siddh Jyotish" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:locale" content="en_US" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="apple-touch-icon" href="/favicon.svg" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:wght@500;600&family=Fraunces:opsz,wght@9..144,400;9..144,500;9..144,600&family=Inter:wght@400;500;600;700&display=swap"
      rel="stylesheet"
    />
    <script type="application/ld+json" set:html={JSON.stringify(siteStructuredData)}></script>
    <title>{title}</title>
  </head>
  <body>
    <header class="site-nav">
      <a class="brand" href="/">
        <span class="brand-mark" aria-hidden="true"><Icon name="compass" size={40} /></span>
        <span class="brand-text">SiddhJyotish</span>
      </a>
      <nav id="mobile-nav" class="nav-links" aria-label="Primary navigation">
        <a href="/#how">How it works</a>
        <a href="/#about">About</a>
        <a href="/#faq">FAQ</a>
        <a href={Astro.locals.user ? '/account' : '/login'}>Login</a>
        <a class="nav-cta" href={Astro.locals.user ? '/#order' : `/register?next=${encodeURIComponent('/#order')}`}>Get started</a>
      </nav>
      <button class="nav-toggle" type="button" aria-expanded="false" aria-controls="mobile-nav" aria-label="Menu">
        <span class="nav-toggle-menu"><Icon name="menu" size={22} /></span>
        <span class="nav-toggle-close"><Icon name="x" size={22} /></span>
      </button>
    </header>

    <main>
      <slot />
    </main>

    <footer class="site-footer">
      <div class="footer-inner">
        <p class="footer-brand"><Icon name="om" size={22} /> Siddh Jyotish</p>
        <p>Precise Vedic astrology, prepared by respected astrologers.</p>
        <p class="footer-lineage">
          Our astrologers are Siddh Yogis carrying forward a centuries-old
          living tradition — descended from a <strong>Kashmiri Pandit</strong>
          lineage and a <strong>Kerala Namboodiri Brahmin</strong> lineage of
          Jyotish scholars. Every reading is computed with honesty and precision
          and offered as a genuine guide — not a $5 horoscope app.
        </p>
        <p class="footer-fine">
          Private account · Your reading is secure · 100% money-back guarantee
        </p>
      </div>
    </footer>

    <script>
      const navToggle = document.querySelector<HTMLButtonElement>('.nav-toggle');
      const mobileNav = document.getElementById('mobile-nav');

      function closeMobileNav() {
        if (!navToggle || !mobileNav) return;
        navToggle.setAttribute('aria-expanded', 'false');
        mobileNav.classList.remove('open');
      }

      navToggle?.addEventListener('click', () => {
        if (!mobileNav) return;
        const expanded = navToggle.getAttribute('aria-expanded') === 'true';
        navToggle.setAttribute('aria-expanded', String(!expanded));
        mobileNav.classList.toggle('open', !expanded);
      });

      mobileNav?.querySelectorAll('a').forEach((link) => {
        link.addEventListener('click', closeMobileNav);
      });

      document.addEventListener('keydown', (event) => {
        if (event.key === 'Escape') closeMobileNav();
      });

      document.addEventListener('click', (event) => {
        if (!navToggle || !mobileNav || !mobileNav.classList.contains('open')) return;
        const target = event.target as Node;
        if (!navToggle.contains(target) && !mobileNav.contains(target)) closeMobileNav();
      });
    </script>

    <style is:global>
      :root {
        --saffron: #f2695c;
        --marigold: #f5c15c;
        --green: #1f7a4d;
        --green-2: #2e9e63;
        --maroon: #221a4e;
        --maroon-deep: #221a4e;
        --gold: #f5c15c;
        --gold-soft: #f5c15c;
        --indigo: #221a4e;
        --indigo-2: #43227e;
        --cream: #f6f5f8;
        --card: #fff;
        --text: #27233c;
        --muted: #66627a;
        --border: #e8e5ee;
        --error: #a12020;
        --serif: 'Fraunces', Georgia, serif;
        --serif-2: 'Cormorant Garamond', Georgia, serif;
        --sans: 'Inter', system-ui, sans-serif;
      }

      * { box-sizing: border-box; }
      html { scroll-behavior: smooth; }
      html, body { margin: 0; padding: 0; }

      body {
        background:
          radial-gradient(1200px 400px at 50% -120px, #fff 0%, transparent 70%),
          var(--cream);
        color: var(--text);
        font-family: var(--sans);
        line-height: 1.65;
        font-optical-sizing: auto;
        min-height: 100vh;
        display: flex;
        flex-direction: column;
      }

      h1, h2, h3 { font-family: var(--serif); font-weight: 500; line-height: 1.15; }
      h1 { font-size: clamp(2.1rem, 4.5vw, 3.3rem); line-height: 1.1; letter-spacing: -0.015em; margin: 0 0 1rem; color: var(--maroon); }
      h2 { font-size: clamp(1.5rem, 3vw, 2.1rem); margin: 0 0 1rem; color: var(--maroon); }
      h3 { font-size: 1.2rem; margin: 0 0 0.5rem; color: var(--maroon-deep); }
      p { margin: 0 0 1rem; }
      a { color: var(--maroon); text-decoration: none; }
      a:hover { text-decoration: underline; }

      main { flex: 1 0 auto; }

      .wrap { width: 100%; max-width: 1040px; margin: 0 auto; padding: 0 1.25rem; }
      .narrow { max-width: 620px; margin: 0 auto; }
      .center { text-align: center; }

      /* ---------- Nav ---------- */
      .site-nav {
        position: sticky;
        top: 0;
        z-index: 30;
        display: flex; align-items: center; justify-content: space-between;
        width: 100%; max-width: 1280px; margin: 0 auto; padding: 1.15rem 2.25rem;
        background: rgba(246, 245, 248, 0.9);
        backdrop-filter: blur(14px);
        -webkit-backdrop-filter: blur(14px);
        border-bottom: 1px solid rgba(232, 229, 238, 0.8);
      }
      .brand { display: flex; align-items: center; gap: 0.55rem; color: var(--indigo); }
      .brand:hover { text-decoration: none; }
      .brand-mark { color: var(--gold); display: inline-flex; flex-shrink: 0; }
      .brand-text { font-family: var(--serif); font-size: 1.48rem; letter-spacing: -0.02em; }
      .nav-links { display: flex; align-items: center; gap: 2rem; font-weight: 500; font-size: 0.88rem; }
      .nav-links a { color: var(--muted); }
      .nav-links a:not(.nav-cta) { display: inline-flex; align-items: center; gap: 0.35rem; }
      .nav-cta {
        display: inline-flex; align-items: center; justify-content: center;
        min-height: 42px; padding: 0 1.25rem; border-radius: 999px;
        background: linear-gradient(110deg, #6f48c7, #26b9aa); color: #fff !important;
        font-size: 0.9rem; font-weight: 600; letter-spacing: 0.01em;
      }
      .nav-cta:hover { filter: brightness(1.05); text-decoration: none; }
      .nav-toggle { display: none; }
      .nav-toggle-close { display: none; }
      @media (max-width: 760px) {
        .site-nav { position: sticky; padding: 0.85rem 1.25rem; }
        .nav-toggle {
          display: inline-flex; align-items: center; justify-content: center;
          width: 40px; height: 40px; padding: 0; border: 0;
          border-radius: 10px; background: transparent; color: var(--indigo); cursor: pointer;
        }
        .nav-links {
          display: none; position: absolute; top: calc(100% + 0.4rem); left: 1rem; right: 1rem;
          max-height: min(70vh, 420px); overflow-y: auto; flex-direction: column; align-items: stretch;
          gap: 0.25rem; padding: 0.65rem; background: rgba(255,253,248,0.98);
          border: 1px solid var(--border); border-radius: 16px;
          box-shadow: 0 18px 40px rgba(27,20,64,0.16);
        }
        .nav-links.open { display: flex; }
        .nav-links a { min-height: 44px; display: flex; align-items: center; padding: 0.55rem 0.75rem; border-radius: 10px; }
        .nav-links a:hover { background: #f8edd0; text-decoration: none; }
        .nav-links .nav-cta { justify-content: center; margin-top: 0.25rem; }
        .nav-toggle[aria-expanded="true"] .nav-toggle-menu { display: none; }
        .nav-toggle[aria-expanded="true"] .nav-toggle-close { display: inline-flex; }
      }

      /* ---------- Hero ---------- */
      .hero {
        position: relative; overflow: hidden;
        background:
          radial-gradient(700px 320px at 80% -40px, rgba(243,168,56,0.25), transparent 60%),
          radial-gradient(600px 300px at 10% 120%, rgba(201,162,39,0.18), transparent 60%),
          linear-gradient(160deg, var(--indigo) 0%, var(--indigo-2) 55%, #3a2a72 100%);
        color: #f7efe0; border-radius: 22px; margin-top: 0.5rem;
        padding: clamp(2.2rem, 6vw, 4rem) clamp(1.4rem, 5vw, 3.5rem);
        box-shadow: 0 22px 60px rgba(27,20,64,0.28);
      }
      .hero,
      .card,
      .step,
      .quote,
      .badge,
      .final-cta-box,
      .pandit-card,
      .contact-card,
      .guarantee-box,
      .faq details,
      .btn,
      .hero { transition: transform 0.18s ease, box-shadow 0.18s ease, background 0.18s ease, border-color 0.18s ease, color 0.18s ease; }
      .card:hover,
      .step:hover,
      .quote:hover,
      .badge:hover,
      .contact-card:hover,
      .guarantee-box:hover,
      .faq details:hover,
      .pandit-card:hover {
        transform: translateY(-2px);
      }
      .hero::before {
        content: ''; position: absolute; inset: 0;
        background-image:
          radial-gradient(1.5px 1.5px at 20% 30%, rgba(255,255,255,0.7), transparent),
          radial-gradient(1.5px 1.5px at 70% 20%, rgba(255,255,255,0.6), transparent),
          radial-gradient(1px 1px at 40% 70%, rgba(255,255,255,0.5), transparent),
          radial-gradient(1.5px 1.5px at 85% 60%, rgba(255,255,255,0.55), transparent),
          radial-gradient(1px 1px at 55% 45%, rgba(255,255,255,0.5), transparent);
        opacity: 0.7; pointer-events: none;
      }
      .hero > * { position: relative; }
      .hero h1 { color: #fff; }
      .hero .lead { color: #ecdfff; font-size: clamp(1.05rem, 2.4vw, 1.3rem); max-width: 40ch; }
      .eyebrow {
        display: inline-block; font-family: var(--sans); font-weight: 600;
        letter-spacing: 2px; text-transform: uppercase; font-size: 0.8rem;
        color: var(--gold-soft); margin-bottom: 1rem;
      }
      .price-tag {
        display: inline-flex; align-items: baseline; gap: 0.5rem; margin: 0.5rem 0 1.5rem;
      }
      .price-tag b { font-family: var(--serif); font-size: 2rem; color: #fff; }
      .price-tag span { color: #d9ccff; font-size: 0.95rem; }
      .was { color: #b9a6e6; text-decoration: line-through; font-size: 1.25rem; opacity: 0.75; }
      .was-btn { opacity: 0.65; text-decoration: line-through; margin-right: 0.35rem; font-weight: 600; }

      /* ---------- Buttons ---------- */
      .btn {
        display: inline-flex; align-items: center; justify-content: center; gap: 0.5rem;
        min-height: 52px; text-align: center; cursor: pointer;
        font-family: var(--sans); font-weight: 600; font-size: 1rem; letter-spacing: 0.01em;
        color: var(--indigo); border: none; border-radius: 12px; padding: 0 1.6rem;
        background: linear-gradient(180deg, var(--gold-soft), var(--gold));
        box-shadow: 0 8px 20px rgba(201,162,39,0.28);
        transition: transform 0.16s ease, box-shadow 0.16s ease, background 0.16s ease, color 0.16s ease, border-color 0.16s ease;
      }
      .btn:hover { transform: translateY(-1px); text-decoration: none; box-shadow: 0 12px 28px rgba(201,162,39,0.5); }
      .btn:focus-visible, .nav-cta:focus-visible, .nav-toggle:focus-visible {
        outline: none; box-shadow: 0 0 0 3px rgba(201,162,39,0.5), 0 0 0 6px rgba(27,20,64,0.25);
      }
      .btn:disabled { opacity: 0.6; cursor: not-allowed; transform: none; }
      .btn-block { display: flex; width: 100%; margin-top: 1.5rem; }
      .btn-ghost {
        min-height: 52px; background: transparent; color: #fff; border: 1.5px solid rgba(255,255,255,0.5);
        box-shadow: none;
      }
      .btn-ghost:hover { background: rgba(255,255,255,0.1); }
      .btn-outline {
        min-height: 52px; background: transparent;
        color: var(--maroon);
        border: 1.5px solid var(--maroon); border-radius: 12px;
        box-shadow: none;
      }
      .btn-outline:hover {
        background: rgba(122, 30, 30, 0.08);
        color: var(--maroon-deep);
        text-decoration: none;
      }
      .hero-cta { display: flex; flex-wrap: wrap; gap: 0.8rem; align-items: center; }

      /* ---------- Section ---------- */
      section.block { padding: clamp(2.5rem, 6vw, 4rem) 0; }
      .section-head { text-align: center; max-width: 42ch; margin: 0 auto 2rem; }
      .section-head p { color: var(--muted); }

      /* ---------- Trust badges ---------- */
      .badges { display: grid; grid-template-columns: repeat(auto-fit, minmax(200px, 1fr)); gap: 1rem; }
      .badge {
        background: var(--card); border: 1px solid var(--border); border-radius: 16px;
        padding: 1.3rem 1.1rem; text-align: center;
        box-shadow: 0 6px 18px rgba(122,30,30,0.06);
      }
      .badge .ico { font-size: 1.8rem; }
      .badge .ico svg { display: block; margin: 0 auto; color: var(--gold); }
      .badge b { display: block; font-family: var(--serif); font-size: 1.1rem; color: var(--maroon); margin: 0.4rem 0 0.2rem; }
      .badge span { color: var(--muted); font-size: 0.9rem; }
      @media (max-width: 640px) { .badges { grid-template-columns: 1fr; } }

      /* ---------- Steps ---------- */
      .steps { display: grid; grid-template-columns: repeat(3, 1fr); gap: 1.2rem; }
      .step {
        background: var(--card); border: 1px solid var(--border); border-radius: 16px;
        padding: 1.5rem 1.3rem; position: relative;
      }
      .step .num {
        width: 40px; height: 40px; border-radius: 50%; display: grid; place-items: center;
        font-family: var(--serif); font-size: 1.2rem; color: #fff; margin-bottom: 0.8rem;
        background: linear-gradient(140deg, var(--saffron), var(--maroon));
      }
      @media (max-width: 720px) { .steps { grid-template-columns: 1fr; } }

      /* ---------- Cards / forms ---------- */
      .card {
        background: var(--card); border: 1px solid var(--border); border-radius: 20px;
        padding: clamp(1.4rem, 4vw, 2.2rem);
        box-shadow: 0 16px 44px rgba(122,30,30,0.09);
      }
      .card-accent { border-top: 4px solid var(--gold); }

      label { display: block; font-weight: 600; margin: 1.1rem 0 0.35rem; color: var(--maroon-deep); }
      label:first-of-type { margin-top: 0; }
      input, textarea, select {
        width: 100%; padding: 0.75rem 0.85rem; font-size: 1rem; font-family: inherit;
        color: var(--text); background: #fff; border: 1px solid var(--border); border-radius: 10px;
      }
      select { appearance: none; background-image: linear-gradient(45deg, transparent 50%, var(--muted) 50%), linear-gradient(135deg, var(--muted) 50%, transparent 50%); background-position: calc(100% - 20px) 1.1rem, calc(100% - 15px) 1.1rem; background-size: 5px 5px, 5px 5px; background-repeat: no-repeat; }
      input:focus, textarea:focus, select:focus {
        outline: none; border-color: var(--saffron);
        box-shadow: 0 0 0 3px rgba(224,129,47,0.18);
      }
      textarea { min-height: 4.5rem; resize: vertical; }
      .helper { color: var(--muted); font-size: 0.88rem; margin: 0.3rem 0 0; }
      .grid-2 { display: grid; grid-template-columns: 1fr 1fr; gap: 0 1rem; }
      @media (max-width: 520px) { .grid-2 { grid-template-columns: 1fr; } }

      .error {
        color: var(--error); background: #fbeaea; border: 1px solid #e6bcbc;
        border-radius: 10px; padding: 0.75rem 0.9rem; margin-top: 1rem;
      }

      /* ---------- Testimonials ---------- */
      .testimonials { display: grid; grid-template-columns: repeat(3, 1fr); gap: 1.2rem; }
      .quote {
        background: var(--card); border: 1px solid var(--border); border-radius: 16px;
        padding: 1.4rem; box-shadow: 0 6px 18px rgba(27,20,64,0.06);
      }
      .quote .stars { color: var(--marigold); letter-spacing: 2px; }
      .quote p { font-family: var(--serif-2); font-size: 1.12rem; color: var(--text); }
      .quote .who { color: var(--muted); font-size: 0.9rem; font-weight: 600; }
      @media (max-width: 720px) { .testimonials { grid-template-columns: 1fr; } }

      /* ---------- FAQ ---------- */
      .faq { max-width: 720px; margin: 0 auto; }
      .faq details {
        background: var(--card); border: 1px solid var(--border); border-radius: 12px;
        padding: 0.4rem 1.1rem; margin-bottom: 0.7rem;
      }
      .faq summary {
        cursor: pointer; font-weight: 600; padding: 0.7rem 0; list-style: none;
        color: var(--maroon-deep); display: flex; justify-content: space-between; gap: 1rem;
      }
      .faq summary::-webkit-details-marker { display: none; }
      .faq summary::after { content: '+'; color: var(--saffron); font-size: 1.3rem; }
      .faq details[open] summary::after { content: '−'; }
      .faq details p { color: var(--muted); margin: 0 0 0.8rem; }

      .divider-om { text-align: center; color: var(--gold); margin: 0.5rem 0; }
      .divider-om svg { display: inline-block; }

      /* ---------- Success ---------- */
      .success-hero { text-align: center; padding: 2rem 0 1rem; }
      .pandit-card {
        display: flex; gap: 1rem; align-items: center; text-align: left;
        background: linear-gradient(160deg, #fff, #fdf3e0);
        border: 1px solid var(--border); border-radius: 16px; padding: 1.2rem 1.4rem; margin: 1.4rem 0;
      }
      .pandit-avatar {
        flex: none; width: 56px; height: 56px; border-radius: 50%;
        display: grid; place-items: center; color: #fff;
        background: linear-gradient(140deg, var(--saffron), var(--maroon));
      }

      .site-footer { flex-shrink: 0; background: var(--indigo); color: #d9ccff; margin-top: 2rem; }
      .footer-inner { max-width: 600px; margin: 0 auto; padding: 2.4rem 1.5rem; text-align: center; }
      .footer-brand { display: inline-flex; align-items: center; gap: 0.45rem; font-family: var(--serif); font-size: 1.35rem; color: #fff; margin: 0 0 0.5rem; }
      .footer-brand svg { color: var(--gold-soft); }
      .footer-inner p { margin: 0.55rem 0; line-height: 1.65; }
      .footer-lineage { color: #cfc4f0; font-size: 0.95rem; margin: 0.9rem 0; }
      .footer-fine { color: #a99fd6; font-size: 0.88rem; margin-top: 1.1rem; }
    </style>
  </body>
</html>
