{
  "name": "kaalera",
  "version": "1.0.0",
  "main": "index.js",
  "scripts": {
    "build:web": "esbuild src/web/app.ts --bundle --format=esm --target=es2022 --outfile=public/app.js && esbuild src/web/developers.ts --bundle --format=esm --target=es2022 --outfile=public/developers.js",
    "dev": "npm run build:web && wrangler dev --port 8787",
    "db:migrate:local": "wrangler d1 migrations apply kaalera --local",
    "db:migrate:remote": "wrangler d1 migrations apply kaalera --remote",
    "deploy": "npm run build:web && wrangler deploy",
    "typecheck": "tsc --noEmit"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "description": "",
  "dependencies": {
    "hono": "^4.13.13",
    "stripe": "^17.7.0",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20260702.1",
    "@types/node": "^20.19.43",
    "esbuild": "^0.25.12",
    "typescript": "^5.9.3",
    "wrangler": "^4.42.0"
  },
  "type": "module"
}
