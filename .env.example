# ---- Pricing (in USD dollars; converted to cents for Stripe) ----
# Kundli report includes 3 questions. Follow-ups are tiered by question count.
PRICE_KUNDLI_USD=31
PRICE_FOLLOWUP_1_USD=8
PRICE_FOLLOWUP_2_USD=11
PRICE_FOLLOWUP_3_USD=13

# ---- Public site URL (used for Stripe success/cancel redirects) ----
PUBLIC_SITE_URL=http://localhost:4321

# ---- Devin API (backend only; NEVER expose to the browser) ----
# Use a SERVICE USER key (prefix cog_) — it authenticates against the v3 API.
DEVIN_API_KEY=
# Your organization id (prefix org-), required by the v3 org-scoped endpoints.
DEVIN_ORG_ID=
DEVIN_API_BASE=https://api.devin.ai
# Playbook ids for the two playbooks
DEVIN_KUNDLI_PLAYBOOK=playbook-8e0260adcb46404e81c848ea42902698
DEVIN_FOLLOWUP_PLAYBOOK=playbook-59963a5167524c2cbfc6f89e0f210daf

# ---- Reference encryption ----
# 32-byte key, base64-encoded. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
REFERENCE_SECRET=

# ---- Stripe ----
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# ---- Email (Resend) ----
RESEND_API_KEY=
EMAIL_FROM="Siddh Jyotish <onboarding@resend.dev>"
