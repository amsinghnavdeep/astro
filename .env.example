# ---- Pricing (in USD dollars; converted to cents for Stripe) ----
# Kundli report includes 3 questions. Follow-ups are tiered by question count.
PRICE_KUNDLI_USD=31
PRICE_FOLLOWUP_1_USD=8
PRICE_FOLLOWUP_2_USD=11
PRICE_FOLLOWUP_3_USD=13

# ---- Public site URL (used for Stripe success/cancel redirects) ----
PUBLIC_SITE_URL=http://localhost:4321

# ---- Devin API (backend only; NEVER expose to the browser) ----
# Use a SERVICE USER key (prefix cog_) — it authenticates against the v3 API.
DEVIN_API_KEY=
# Your organization id (prefix org-), required by the v3 org-scoped endpoints.
DEVIN_ORG_ID=
DEVIN_API_BASE=https://api.devin.ai
# Playbook id for the initial Kundli chart-generation playbook (!kundli).
DEVIN_KUNDLI_PLAYBOOK=
# Playbook id for the follow-up Q&A playbook (!kundli_followup).
# NOTE: not currently used at runtime — the Devin v3 message API does not
# accept a playbook_id, so follow-ups resume the original session context.
# Kept here for documentation and future API support.
DEVIN_FOLLOWUP_PLAYBOOK=

# ---- Cloud Run report service ----
# HTTPS URL of the deployed FastAPI service, without a trailing slash.
KUNDLI_SERVICE_URL=
# Shared bearer token configured on the Cloud Run service.
KUNDLI_SERVICE_TOKEN=
# Set exactly to "true" only while reverting Kundli fulfillment to Devin.
USE_DEVIN_FULFILLMENT=false

# ---- Reference encryption ----
# 32-byte key, base64-encoded. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
REFERENCE_SECRET=

# ---- Stripe ----
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# ---- Email (Resend) ----
RESEND_API_KEY=
EMAIL_FROM="Siddh Jyotish <namaste@siddhjyotish.com>"

# ---- Admin API (runtime pricing + orders) ----
# Bearer token protecting GET/PUT /api/admin/pricing and GET /api/admin/orders.
ADMIN_API_TOKEN=

# ---- API docs (Basic Auth) ----
DOCS_AUTH_USER=
DOCS_AUTH_PASS=
