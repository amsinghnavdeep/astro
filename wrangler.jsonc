{
  // Cloudflare deployment config for the Siddh Jyotish Astro SSR app.
  //
  // The Astro Cloudflare adapter emits a Worker at dist/_worker.js/index.js and
  // static assets in dist/. This config deploys it to Cloudflare Workers with
  // static-asset serving. (The same build output can also be deployed to
  // Cloudflare Pages with `wrangler pages deploy dist` — see README.)
  "name": "siddh-jyotish",
  "main": "./dist/_worker.js/index.js",
  // Date >= 2025-04-01 is required so that, with nodejs_compat, the Workers
  // runtime populates `process.env` from vars/secrets (read by env.ts).
  "compatibility_date": "2025-04-01",
  // nodejs_compat provides node:crypto (reference.ts AES-256-GCM) + Buffer, and
  // (with the date above) populates process.env from vars/secrets.
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "binding": "ASSETS",
    "directory": "./dist"
  },
  "observability": {
    "enabled": true
  }

  // Runtime secrets/vars are NOT stored here. Set them with:
  //   wrangler secret put STRIPE_SECRET_KEY   (and the other vars in .env.example)
  // For local `wrangler dev`, put them in a gitignored .dev.vars file.
}
